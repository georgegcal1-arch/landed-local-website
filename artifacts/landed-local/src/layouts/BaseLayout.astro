---
import "../styles/global.css";
import tokens from "../styles/tokens.css?raw";
import { site } from "../config/site";
import Header from "../components/shell/Header.astro";
import Footer from "../components/shell/Footer.astro";
import MobileActionBar from "../components/shell/MobileActionBar.astro";

interface Props {
  /** Page title. The business name is appended. */
  title: string;
  /** Override the default business-name suffix when a page needs a specific full title. */
  titleSuffix?: string;
  /** Meta description. Falls back to the site default. */
  description?: string;
  /** Share image path. Falls back to the site default. */
  ogImage?: string;
  /** Set true to keep the page out of search results. */
  noindex?: boolean;
}

const {
  title,
  titleSuffix = site.business.name,
  description = site.site.defaultDescription,
  ogImage = site.site.ogImage,
  noindex = false,
} = Astro.props;
const fullTitle = title === site.business.name ? title : `${title} | ${titleSuffix}`;
const canonicalPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(canonicalPath === "/404" ? "/404.html" : canonicalPath, site.site.url).href;
const ogImageUrl = new URL(ogImage, site.site.url).href;
const professionalService = Astro.url.pathname === "/" ? {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.business.name,
  legalName: site.business.legalName,
  url: site.site.url,
  logo: new URL(site.brand.headerLogo, site.site.url).href,
  image: ogImageUrl,
  telephone: `+1-${site.contact.phoneDisplay}`,
  email: site.contact.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.business.city,
    addressRegion: site.business.stateCode,
    addressCountry: site.business.countryCode,
  },
  areaServed: site.business.serviceArea,
  priceRange: `$${site.pricing.founding}-$${site.pricing.standard}`,
} : null;
// Resolve at build time so browser chrome works even with JavaScript disabled.
const themeColor = tokens.match(/--color-offwhite:\s*([^;]+);/)?.[1]?.trim();
if (!themeColor) throw new Error("Missing --color-offwhite design token");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />

    <link rel="icon" href={site.brand.faviconIco} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={site.brand.faviconSvg} />
    <link rel="icon" type="image/png" sizes="16x16" href={site.brand.favicon16} />
    <link rel="icon" type="image/png" sizes="32x32" href={site.brand.favicon32} />
    <link rel="icon" type="image/png" sizes="48x48" href={site.brand.favicon48} />
    <link rel="apple-touch-icon" sizes="180x180" href={site.brand.appleTouchIcon} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.business.name} — ${site.business.tagline}`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${site.business.name} — ${site.business.tagline}`} />
    {professionalService && <script type="application/ld+json" set:html={JSON.stringify(professionalService).replace(/</g, "\\u003c")} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
  </body>
</html>
