---
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"span">;
const { class: extra, ...rest } = Astro.props;
---
<span class:list={["pill", extra]} {...rest}><slot /></span>

<style>
  .pill {
    display: inline-flex; align-items: center; padding: var(--pill-pad-y) var(--pill-pad-x);
    border-radius: var(--radius-pill); background: var(--color-orange-tint); color: var(--color-orange-burnt);
    font-family: var(--font-body); font-weight: var(--weight-semibold); font-size: var(--text-pill); line-height: var(--leading-tight);
  }
</style>
