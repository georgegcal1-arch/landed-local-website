---
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "secondary" | "text-link";
type Common = { variant?: Variant; class?: string; fullWidthMobile?: boolean };
type AsLink = Common & HTMLAttributes<"a"> & { href: string };
type AsButton = Common & HTMLAttributes<"button"> & { href?: undefined };
export type Props = AsLink | AsButton;

const { variant = "primary", class: extra, href, fullWidthMobile = false, ...rest } = Astro.props as Common & { href?: string } & Record<string, unknown>;
const cls = ["btn", `btn--${variant}`, fullWidthMobile && "btn--full-width-mobile", extra].filter(Boolean).join(" ");
const buttonType = (rest.type ?? "button") as "button" | "submit" | "reset";
---
{href !== undefined
  ? <a href={href} class={cls} {...rest}><slot /></a>
  : <button type={buttonType} class={cls} {...rest}><slot /></button>}

<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space);
    min-height: var(--button-min-h);
    padding: var(--button-pad-y) var(--button-pad-x);
    font-family: var(--font-body); font-weight: var(--weight-semibold);
    font-size: var(--text-button); line-height: var(--leading-tight);
    border: var(--stroke-outline) solid transparent;
    border-radius: var(--radius-sharp) var(--radius-sharp) var(--radius-sharp) var(--radius-corner);
    text-decoration: none; cursor: pointer;
    transition: background-color var(--dur-hover) var(--ease-out), color var(--dur-hover) var(--ease-out), border-color var(--dur-hover) var(--ease-out);
  }
  .btn:focus-visible { outline: var(--stroke-focus) solid var(--color-teal); outline-offset: var(--focus-offset); }
  @media (max-width: 639px) {
    .btn--full-width-mobile { width: 100%; }
    .btn--full-width-mobile.btn--text-link { order: 1; justify-content: flex-start; }
  }
  .btn--primary { background: var(--color-orange); color: var(--color-charcoal); border-color: var(--color-orange); }
  .btn--primary:hover { background: var(--color-orange-burnt); border-color: var(--color-orange-burnt); color: var(--color-offwhite); }
  .btn--secondary { background: transparent; color: var(--color-teal); border-color: var(--color-teal); }
  .btn--secondary:hover { background: var(--color-teal-tint); }
  .btn--text-link { background: transparent; color: var(--color-teal); padding-inline: 0; border-color: transparent; text-underline-offset: 0.2em; }
  .btn--text-link:hover { text-decoration: underline; text-decoration-thickness: var(--stroke-outline); }
  :global([data-tone="dark"]) .btn--secondary, :global([data-tone="dark"]) .btn--text-link { color: var(--color-teal-light); border-color: currentColor; }
  :global([data-tone="dark"]) .btn--text-link { border-color: transparent; }
  :global([data-tone="dark"]) .btn--secondary:hover { background: transparent; color: var(--color-offwhite); border-color: var(--color-offwhite); }
  :global([data-tone="dark"]) .btn:focus-visible { outline-color: var(--color-teal-light); }
  :global([data-tone="dark"] [data-tone="light"]) .btn--secondary { color: var(--color-teal); border-color: var(--color-teal); }
  :global([data-tone="dark"] [data-tone="light"]) .btn--text-link { color: var(--color-teal); }
  :global([data-tone="dark"] [data-tone="light"]) .btn:focus-visible { outline-color: var(--color-teal); }
  .btn:disabled, .btn[aria-disabled="true"] { opacity: var(--opacity-disabled); cursor: not-allowed; }
  .btn--primary:disabled:hover, .btn--primary[aria-disabled="true"]:hover {
    background: var(--color-orange); border-color: var(--color-orange); color: var(--color-charcoal);
  }
  .btn--secondary:disabled:hover, .btn--secondary[aria-disabled="true"]:hover {
    background: transparent; color: var(--color-teal); border-color: var(--color-teal);
  }
  .btn--text-link:disabled:hover, .btn--text-link[aria-disabled="true"]:hover {
    background: transparent; color: var(--color-teal); text-decoration: none;
  }
  :global([data-tone="dark"]) .btn--secondary:disabled:hover,
  :global([data-tone="dark"]) .btn--secondary[aria-disabled="true"]:hover,
  :global([data-tone="dark"]) .btn--text-link:disabled:hover,
  :global([data-tone="dark"]) .btn--text-link[aria-disabled="true"]:hover {
    color: var(--color-teal-light); border-color: currentColor;
  }
  :global([data-tone="dark"]) .btn--text-link:disabled:hover,
  :global([data-tone="dark"]) .btn--text-link[aria-disabled="true"]:hover { border-color: transparent; }
  :global([data-tone="dark"] [data-tone="light"]) .btn--secondary:disabled:hover,
  :global([data-tone="dark"] [data-tone="light"]) .btn--secondary[aria-disabled="true"]:hover,
  :global([data-tone="dark"] [data-tone="light"]) .btn--text-link:disabled:hover,
  :global([data-tone="dark"] [data-tone="light"]) .btn--text-link[aria-disabled="true"]:hover {
    color: var(--color-teal); border-color: currentColor;
  }
</style>
