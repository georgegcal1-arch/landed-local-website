---
import MessageSquare from "lucide-astro/MessageSquare";
import PhoneCall from "lucide-astro/PhoneCall";
import ShieldCheck from "lucide-astro/ShieldCheck";
import Button from "../Button.astro";
import Card from "../Card.astro";
import CheckList from "../CheckList.astro";
import Eyebrow from "../Eyebrow.astro";
import JobTicket from "../JobTicket.astro";
import Pill from "../Pill.astro";
import Section from "../Section.astro";
import { site } from "../../config/site";

const { offer, pricing, afterLaunch, shell } = site;
const usd = (amount: number) => `$${amount.toLocaleString("en-US")}`;
const ticketItems = [
  { label: `Up to ${offer.maxPages} pages` },
  { label: "Built for phones first" },
  { label: "Tap-to-call and quote form" },
  { label: "Google reviews section" },
  { label: "Local Google search setup" },
  { label: `${offer.callTrackingDays} days of call tracking` },
  { label: `${offer.revisionRounds} rounds of revisions` },
  { label: "Live in", value: `${offer.liveInDays} days` },
];
const careItems = [
  "Hosting, security and backups handled",
  "Up to 2 small edits a month",
  "Monthly report of calls from your site",
  "A monthly check of your Google Business Profile",
];
const teasers = [
  {
    icon: ShieldCheck,
    title: "Keep it running",
    copy: `The ${usd(pricing.carePlanMonthly)}/month care plan above.`,
  },
  {
    icon: MessageSquare,
    title: "Win back old quotes",
    copy: "I text your past quotes and hand you every reply.",
  },
  {
    icon: PhoneCall,
    title: "Never let a lead slip",
    copy: "Missed calls get a text back in seconds.",
  },
];
---

<Section id="pricing" bg="paper" blueprint class="pricing">
  <Eyebrow>Pricing</Eyebrow>
  <h2 class="pricing__heading">One price. No surprises.</h2>
  <p class="pricing__intro">Many agencies charge thousands for a custom site or lock you into a monthly contract. Mine is one price, and the site is yours.</p>

  <div class="pricing__grid">
    <div class="pricing__main">
      <JobTicket
        number="#001"
        title="Custom website"
        items={ticketItems}
        total={{ label: "Your price", previousValue: usd(pricing.standard), value: usd(pricing.founding) }}
        stamp="APPROVED"
        stampPlacement="top-right"
        class="pricing__ticket"
      >
        <div slot="after" class="pricing__details">
          <div class="pricing__founding">
            <Pill>Founding client price · first {pricing.foundingSpotsTotal} clients</Pill>
            <p>in exchange for an honest review if you're happy.</p>
          </div>
          {pricing.showSpotsLeft && (
            <p class="pricing__spots">{pricing.foundingSpotsLeft} of {pricing.foundingSpotsTotal} founding spots left</p>
          )}
          <ul class="pricing__payments">
            {pricing.paymentOptions.map((option) => <li><small>{option}</small></li>)}
          </ul>
          <CheckList items={[pricing.guarantee]} class="pricing__guarantee" />
          <Button href={shell.cta.href}>Get my free mockup</Button>
        </div>
      </JobTicket>
    </div>

    <div class="pricing__side">
      <Card as="aside" class="pricing__care">
        <Eyebrow>Optional</Eyebrow>
        <h3>Care plan</h3>
        <p class="price pricing__care-price">{usd(pricing.carePlanMonthly)}/month</p>
        <CheckList items={careItems} class="pricing__care-list" />
        <small class="pricing__care-note">Month to month. Cancel anytime. Not required.</small>
      </Card>
      <Card as="aside" class="pricing__next">
        <h3>What happens next</h3>
        <ol>
          <li>Free mockup, usually same day</li>
          <li>15-minute walkthrough call</li>
          <li>Live in 7 days after you send your content</li>
        </ol>
      </Card>
    </div>
  </div>

  <div class="pricing__after-launch">
    <Eyebrow>After launch</Eyebrow>
    <div class="pricing__teasers">
      {teasers.map(({ icon: Icon, title, copy }) => (
        <article class="pricing__teaser">
          <Icon class="pricing__teaser-icon" size={24} strokeWidth={2} aria-hidden="true" />
          <div>
            <h3>{title}</h3>
            <p>{copy}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="pricing__after-note">
      <p>Ask me about these on your call.</p>
      {afterLaunch.pageLive && <Button variant="text-link" href="/after-launch">See what's next</Button>}
    </div>
  </div>
</Section>

<style>
  .pricing__heading { margin: calc(var(--space) * 2) 0 var(--space); }
  .pricing__intro { max-width: 72ch; margin: 0; }
  .pricing__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(var(--space) * 3); margin-top: calc(var(--space) * 4); align-items: start; }
  .pricing__main { min-width: 0; }
  .pricing__details { display: flex; flex-direction: column; align-items: flex-start; gap: calc(var(--space) * 2); width: 100%; box-sizing: border-box; padding-top: calc(var(--space) * 2); }
  .pricing__founding p, .pricing__after-note p { margin: var(--space) 0 0; }
  .pricing__founding p { font-size: var(--text-small); color: var(--color-steel); }
  .pricing__spots { margin: 0; font-weight: var(--weight-semibold); }
  .pricing__payments { display: grid; gap: var(--space); list-style: none; margin: 0; padding: 0; }
  .pricing__guarantee { margin-top: var(--space); }
  .pricing__details :global(.btn) { margin-top: var(--space); }
  .pricing__side { display: grid; gap: calc(var(--space) * 3); }
  .pricing__care { display: flex; flex-direction: column; align-items: flex-start; gap: calc(var(--space) * 2); }
  .pricing__next { display: grid; align-content: start; gap: calc(var(--space) * 2); }
  .pricing__next h3 { margin: 0; }
  .pricing__next ol { display: grid; gap: var(--space); margin: 0; padding-left: calc(var(--space) * 3); list-style: decimal; }
  .pricing__care h3, .pricing__teaser h3 { margin: 0; }
  .pricing__care-price { margin: 0; color: var(--color-charcoal); font-size: var(--pricing-care-size); line-height: var(--leading-tight); }
  .pricing__care-list { gap: calc(var(--space) * 1.5); }
  .pricing__care-note { margin-top: auto; }
  .pricing__after-launch { margin-top: calc(var(--space) * 7); padding-top: calc(var(--space) * 4); border-top: var(--stroke-hair) solid var(--color-rule); }
  .pricing__teasers { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(var(--space) * 3); margin-top: calc(var(--space) * 2); }
  .pricing__teaser { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: calc(var(--space) * 1.5); align-items: start; }
  .pricing__teaser-icon { color: var(--color-teal); margin-top: calc(var(--space) * 0.5); }
  .pricing__teaser h3 { font-size: var(--text-body); font-weight: var(--weight-bold); }
  .pricing__teaser p { margin: 0; font-size: var(--text-small); color: var(--color-steel); }
  .pricing__after-note { display: flex; flex-direction: column; align-items: center; gap: var(--space); margin-top: calc(var(--space) * 3); text-align: center; }
  .pricing__after-note p { margin: 0; font-weight: var(--weight-semibold); }
  @media (min-width: 900px) {
    .pricing__grid { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }
    .pricing__details { gap: calc(var(--space) * 1.25); }
    .pricing__ticket :global(.ticket__items) { gap: calc(var(--space) * 0.5); }
    .pricing__ticket :global(.ticket__item) { line-height: var(--leading-tight); }
    .pricing__next ol { gap: calc(var(--space) * 2); }
    .pricing__next li { padding-block: calc(var(--space) * 2); }
    .pricing__teasers { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(var(--space) * 4); }
    .pricing__after-note { flex-direction: row; justify-content: center; }
  }
</style>
