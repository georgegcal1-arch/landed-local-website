---
import Button from "../Button.astro";
import Eyebrow from "../Eyebrow.astro";
import RulerDivider from "../RulerDivider.astro";
import Section from "../Section.astro";
import { site } from "../../config/site";

const steps = [
  {
    title: "Free mockup",
    copy: "Tell me about your business and I'll send a custom preview of your site, free.",
  },
  {
    title: "Quick walkthrough",
    copy: "A 15-minute call to go over the mockup and anything you'd change.",
  },
  {
    title: "Build",
    copy: "Send your logo, photos and services. Your site is live within 7 days.",
  },
  {
    title: "Launch and call report",
    copy: "After 30 days, I show you how many calls your site brought in.",
  },
];
---

<Section id="how-it-works" bg="offwhite" class="how-it-works">
  <Eyebrow>How it works</Eyebrow>
  <h2 class="how-it-works__heading">From phone call to live site in about a week</h2>
  <ol class="how-it-works__steps">
    <RulerDivider variant="orange" class="how-it-works__ruler" />
    {steps.map((step, index) => (
      <li class="how-it-works__step">
        <span class="how-it-works__number" data-reveal style={`--step-index:${index}`}>{index + 1}</span>
        <h3>{step.title}</h3>
        <p>{step.copy}</p>
      </li>
    ))}
  </ol>
  <div class="how-it-works__cta">
    <Button href={site.shell.cta.href}>Start with a free mockup</Button>
  </div>
</Section>

<style>
  .how-it-works__heading { margin: calc(var(--space) * 2) 0 calc(var(--space) * 5); }
  .how-it-works__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: calc(var(--space) * 3);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .how-it-works__steps > :global(.how-it-works__ruler) {
    position: absolute;
    z-index: 0;
    inset: calc(var(--steps-marker-size) / 2 - var(--ruler-h) + var(--steps-ruler-base)) 0 auto;
    width: 100%;
  }
  .how-it-works__steps > :global(.how-it-works__ruler .ruler__line) { y: 13px; height: var(--steps-ruler-base); }
  .how-it-works__step { position: relative; z-index: 1; min-width: 0; text-align: center; }
  .how-it-works__number {
    display: grid;
    place-items: center;
    width: var(--steps-marker-size);
    height: var(--steps-marker-size);
    margin: 0 auto calc(var(--space) * 2);
    border-radius: 50%;
    background: var(--color-charcoal);
    color: var(--color-offwhite);
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: var(--weight-heavy);
  }
  .how-it-works__step h3 { margin: 0 0 var(--space); }
  .how-it-works__step p { margin: 0; }
  .how-it-works__cta { display: flex; justify-content: center; margin-top: calc(var(--space) * 5); }
  :global(html.motion-ok) .how-it-works__number:not(.is-in) { opacity: 0; transform: scale(0.7); }
  :global(html.motion-ok) .how-it-works__number.is-in {
    transition: opacity var(--dur-check) var(--ease-out), transform var(--dur-check) var(--ease-out);
    transition-delay: calc(var(--step-index) * var(--stagger-check));
  }
  @media (max-width: 767px) {
    .how-it-works__steps { grid-template-columns: minmax(0, 1fr); gap: calc(var(--space) * 4); }
    .how-it-works__steps::before {
      content: "";
      position: absolute;
      top: calc(var(--steps-marker-size) / 2);
      bottom: calc(var(--steps-marker-size) / 2);
      left: calc(var(--steps-marker-size) / 2 - var(--steps-ruler-base) / 2);
      width: var(--steps-ruler-base);
      background: var(--color-orange);
    }
    .how-it-works__steps > :global(.how-it-works__ruler) { display: none; }
    .how-it-works__step { display: grid; grid-template-columns: var(--steps-marker-size) minmax(0, 1fr); column-gap: calc(var(--space) * 2); text-align: left; }
    .how-it-works__number { grid-row: span 2; margin: 0; }
    .how-it-works__step h3 { align-self: end; margin: 0 0 var(--space); }
    .how-it-works__step p { grid-column: 2; }
    .how-it-works__cta { margin-top: calc(var(--space) * 4); }
  }
</style>
