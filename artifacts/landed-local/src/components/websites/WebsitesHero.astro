---
import { site } from "../../config/site";
import Button from "../Button.astro";
import Eyebrow from "../Eyebrow.astro";
import PencilMark from "../PencilMark.astro";
import Section from "../Section.astro";
---

<Section bg="offwhite" blueprint class="wh">
  <Eyebrow>Websites</Eyebrow>
  <h1 class="wh__title">A website that <PencilMark>brings in calls</PencilMark>. Yours in 7 days.</h1>
  <p class="wh__lead">One price, no required monthly fee, and you own it. Built for local service businesses that run on phone calls and quotes.</p>
  <div class="wh__actions">
    <Button href={site.shell.cta.href} fullWidthMobile>Get my free mockup</Button>
    <Button variant="secondary" href="#pricing" fullWidthMobile>See pricing</Button>
  </div>
</Section>

<style>
  .wh { padding-block: 48px; }
  .wh__title { margin: calc(var(--space) * 2) 0 0; max-width: 18ch; }
  .wh__lead { margin: calc(var(--space) * 3) 0 0; font-size: var(--hero-text-lead); }
  .wh__actions { display: flex; flex-wrap: wrap; gap: var(--space-button-stack); margin-top: calc(var(--space) * 4); }
  @media (min-width: 768px) { .wh { padding-block: 72px; } }
</style>
