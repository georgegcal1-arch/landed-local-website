---
import KeyRound from "lucide-astro/KeyRound";
import MapPin from "lucide-astro/MapPin";
import PhoneCall from "lucide-astro/PhoneCall";
import Ruler from "lucide-astro/Ruler";
import Card from "../Card.astro";
import CheckList from "../CheckList.astro";
import Eyebrow from "../Eyebrow.astro";
import Section from "../Section.astro";
import { site } from "../../config/site";

const { pricing } = site;
const groups = [
  { icon: Ruler, title: "Design and build", items: ["Up to 5 pages", "Designed around your services, photos and brand colors", "Built for phones first", "Fast loading", "2 rounds of revisions"] },
  { icon: MapPin, title: "Getting found", items: ["Page titles and local keywords set up for searches in your area", "Business info marked up for Google", "Linked to your Google Business Profile", "Your best Google reviews on the homepage"] },
  { icon: PhoneCall, title: "Getting the call", items: ["Tap-to-call on every page", "A quote request form that lands in your inbox", "30 days of free call tracking: every call, answered or missed"] },
  { icon: KeyRound, title: "Ownership", items: ["The site and the domain are in your name", "No required monthly fee", `Optional $${pricing.carePlanMonthly}/month care plan if you want me to handle updates`] },
];
---

<Section id="included" bg="offwhite" class="inc">
  <Eyebrow>What's included</Eyebrow>
  <h2 class="inc__heading">Everything a trade website needs, nothing it doesn't</h2>
  <div class="inc__grid">
    {groups.map(({ icon: Icon, title, items }) => (
      <Card as="article" class="inc__card">
        <span class="inc__icon"><Icon size={24} strokeWidth={2} aria-hidden="true" /></span>
        <h3 class="inc__title">{title}</h3>
        <CheckList items={items} />
      </Card>
    ))}
  </div>
</Section>

<style>
  .inc__heading { margin: calc(var(--space) * 2) 0 0; max-width: 24ch; }
  .inc__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(var(--space) * 3); margin-top: calc(var(--space) * 4); }
  .inc__card { height: 100%; }
  .inc__icon {
    display: grid; place-items: center;
    width: var(--problem-icon-size); height: var(--problem-icon-size);
    border-radius: var(--radius-sharp) var(--radius-sharp) var(--radius-sharp) var(--radius-corner);
    background: var(--color-orange-tint); color: var(--color-orange-burnt);
  }
  .inc__title { margin: calc(var(--space) * 2) 0 calc(var(--space) * 2); }
  @media (min-width: 768px) { .inc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
