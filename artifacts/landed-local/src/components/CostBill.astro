---
import Eyebrow from "./Eyebrow.astro";
export interface CostLine { problem: string; cost: string; sentence: string; stat?: string; statLabel?: string; source?: string }
interface Props {
  label?: string;
  items: CostLine[];
  total: { label: string; value: string; note?: string };
  class?: string;
}
const { label = "Cost of doing nothing", items, total, class: extra } = Astro.props;
---
<article class:list={["bill", extra]} data-tone="light">
  <header class="bill__head"><Eyebrow as="span">{label}</Eyebrow></header>
  <ul class="bill__items">
    {items.map((it) => (
      <li class="bill__item">
        <div class="bill__line">
          <span class="bill__problem">{it.problem}</span>
          <span class="bill__leader" aria-hidden="true"></span>
          <svg class="bill__arrow" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2 6 H10 M7 3 L10 6 L7 9" /></svg>
          <span class="bill__cost">{it.cost}</span>
        </div>
        <div class="bill__detail">
          <p class="bill__sentence">{it.sentence}</p>
          {it.stat && (
            <p class="bill__stat-row">
              <span class="stat bill__stat">{it.stat}</span>
              {it.statLabel && <span class="bill__stat-label">{it.statLabel}</span>}
            </p>
          )}
          {it.source && <p class="bill__source">Source: {it.source}</p>}
        </div>
      </li>
    ))}
  </ul>
  <div class="bill__total">
    <span>{total.label}</span>
    <span class="stat bill__total-value">{total.value}</span>
    {total.note && <p class="bill__total-note">{total.note}</p>}
  </div>
</article>

<style>
  .bill {
    background: var(--color-paper); color: var(--color-charcoal);
    border: var(--stroke-hair) solid var(--color-rule);
    border-radius: var(--radius-sharp) var(--radius-sharp) var(--radius-sharp) var(--radius-corner);
    box-shadow: var(--shadow-card); padding: var(--card-pad);
  }
  :global([data-bg="paper"]) .bill { background: var(--color-white); }
  .bill :global(:is(p, li, span)) { color: var(--color-charcoal); }
  .bill :global(.eyebrow), .bill :global(.eyebrow span) { color: var(--color-orange-burnt); }
  .bill__head { padding-bottom: calc(var(--space) * 2); border-bottom: var(--stroke-hair) dashed var(--color-steel); }
  .bill__items { list-style: none; margin: 0; padding: 0; }
  .bill__item { display: grid; gap: calc(var(--space) * 1.5); padding-block: calc(var(--space) * 3); }
  .bill__item + .bill__item { border-top: var(--leader-dot) dotted var(--color-steel); }
  .bill__line { display: grid; align-items: baseline; gap: var(--space); }
  .bill__problem, .bill__cost { font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-h3); line-height: var(--leading-tight); }
  .bill .bill__cost { color: var(--color-orange-burnt); }
  .bill__leader { display: none; min-width: calc(var(--space) * 2); border-bottom: var(--leader-dot) dotted var(--color-steel); transform: translateY(calc(var(--space) * -0.5)); }
  .bill__arrow { display: none; width: calc(var(--space) * 1.5); height: calc(var(--space) * 1.5); align-self: center; }
  .bill__arrow path { fill: none; stroke: var(--color-steel); stroke-width: var(--stroke-ruler); stroke-linecap: round; stroke-linejoin: round; }
  .bill__detail { display: grid; gap: var(--space); }
  .bill__detail p { margin: 0; }
  .bill__stat-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space); }
  .bill__stat { font-size: var(--text-h2); line-height: var(--leading-tight); }
  .bill__stat-label { font-size: var(--text-small); }
  .bill .bill__source { font-size: var(--text-small); color: var(--color-steel); }
  .bill__total {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space);
    padding-top: calc(var(--space) * 2); border-top: var(--stroke-outline) solid var(--color-charcoal); font-weight: var(--weight-semibold);
  }
  .bill__total > :first-child { overflow-wrap: anywhere; }
  .bill__total-value { font-size: var(--text-h3); }
  .bill__total-note { grid-column: 1 / -1; margin: 0; font-weight: var(--weight-regular); }
  @media (min-width: 768px) {
    .bill__item { grid-template-columns: 2fr 3fr; gap: calc(var(--space) * 4); align-items: start; }
    .bill__line { grid-template-columns: minmax(0, 1fr) minmax(calc(var(--space) * 2), 0.25fr) auto minmax(0, 1fr); }
    .bill__leader, .bill__arrow { display: block; }
  }
</style>
