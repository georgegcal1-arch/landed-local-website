---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"img">, "src" | "alt" | "width" | "height"> & {
  src: string;
  alt: string;
  width: number;
  height: number;
};
// Resolve configurable public paths at build time, including future uploaded photos.
const images = import.meta.glob<{ default: ImageMetadata }>("/public/**/*.{png,jpg,jpeg,webp,avif}", { eager: true });
const { src, alt, width, height, loading = "lazy", decoding = "async", sizes = "(max-width: 767px) calc(100vw - 40px), 50vw", ...rest } = Astro.props;
const source = images[`/public${src}`]?.default;
if (src.startsWith("/") && !source) throw new Error(`Raster image not found in public: ${src}`);
const widths = [...new Set([320, 640, 960, width].filter((w) => w <= width))].sort((a, b) => a - b);
---
<Image src={source ?? src} alt={alt} width={width} height={height} widths={widths} sizes={sizes} format="webp" quality={100} loading={loading} decoding={decoding} {...rest} />
