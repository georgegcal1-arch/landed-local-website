---
interface Props { variant?: "rule" | "orange"; class?: string }
const { variant = "rule", class: extra } = Astro.props;
const id = `ruler-${Math.random().toString(36).slice(2, 9)}`;
---
<div class:list={["ruler", `ruler--${variant}`, extra]} data-reveal role="separator" aria-hidden="true">
  <svg class="ruler__svg" width="100%" height="15" preserveAspectRatio="none" focusable="false">
    <defs>
      <pattern id={id} x="0" y="0" width="96" height="15" patternUnits="userSpaceOnUse">
        <rect class="ruler__tick ruler__tick--major" x="0" y="0" width="1.5" height="14" />
        <rect class="ruler__tick" x="24" y="0" width="1.5" height="6" />
        <rect class="ruler__tick ruler__tick--mid" x="48" y="0" width="1.5" height="10" />
        <rect class="ruler__tick" x="72" y="0" width="1.5" height="6" />
      </pattern>
    </defs>
    <g class="ruler__ticks"><rect width="100%" height="14" fill={`url(#${id})`} /></g>
    <rect class="ruler__line" x="0" y="13.5" width="100%" height="1.5" />
  </svg>
</div>

<style>
  /* Pattern uses 24px graduations, 14/10/6px ticks and 1.5px strokes. */
  .ruler { width: 100%; height: var(--ruler-h); overflow: hidden; color: var(--color-ruler-rule-light); }
  .ruler--orange { color: var(--color-orange); }
  .ruler__svg { display: block; width: 100%; height: var(--ruler-h); }
  .ruler__tick { fill: currentColor; }
  .ruler__line { fill: var(--color-ruler-rule-light); }
  .ruler__ticks { transform-box: view-box; }
  :global(html.motion-ok) .ruler:not(.is-in) .ruler__ticks { transform: translateX(-100%); }
  :global(html.motion-ok) .ruler.is-in .ruler__ticks { transition: transform var(--dur-ruler) var(--ease-out); }
  .ruler--orange .ruler__line { fill: currentColor; }
  :global([data-tone="dark"]) .ruler__line { fill: var(--color-ruler-rule-dark); }
  :global([data-tone="dark"]) .ruler--rule { color: var(--color-ruler-rule-dark); }
  :global([data-tone="dark"]) .ruler--orange .ruler__line { fill: currentColor; }
</style>
