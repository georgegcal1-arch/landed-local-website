---
import Button from "../Button.astro";
import Card from "../Card.astro";
import { site } from "../../config/site";

const trades = ["Plumbing","Electrical","HVAC","Tree service","Roofing","Basement waterproofing","Remodeling","Landscaping","Cleaning","Pest control","Garage doors","Auto repair","Other"];
---

<Card class="mf">
  <form class="mf__form" data-mockup-request-form novalidate>
      <div class="mf__field">
        <label for="request-name">Your name</label>
        <input id="request-name" name="name" type="text" autocomplete="name" required aria-describedby="request-name-error" />
        <span class="mf__error" id="request-name-error" hidden></span>
      </div>
      <div class="mf__field">
        <label for="request-business">Business name</label>
        <input id="request-business" name="businessName" type="text" autocomplete="organization" required aria-describedby="request-business-error" />
        <span class="mf__error" id="request-business-error" hidden></span>
      </div>
      <div class="mf__field">
        <label for="request-city">City or town</label>
        <input id="request-city" name="city" type="text" autocomplete="address-level2" required aria-describedby="request-city-error" />
        <span class="mf__error" id="request-city-error" hidden></span>
      </div>
      <div class="mf__field">
        <label for="request-trade">Trade</label>
        <select id="request-trade" name="trade" required aria-describedby="request-trade-error">
          <option value="" selected>Choose your trade</option>
          {trades.map((t) => <option value={t}>{t}</option>)}
        </select>
        <span class="mf__error" id="request-trade-error" hidden></span>
      </div>
      <div class="mf__field mf__field--other" data-other-trade-field hidden>
        <label for="request-other-trade">Your trade</label>
        <input id="request-other-trade" name="otherTrade" type="text" disabled aria-describedby="request-other-trade-error" />
        <span class="mf__error" id="request-other-trade-error" hidden></span>
      </div>
      <div class="mf__field">
        <label for="request-email">Email</label>
        <input id="request-email" name="email" type="email" autocomplete="email" inputmode="email" spellcheck="false" required aria-describedby="request-email-error" />
        <span class="mf__error" id="request-email-error" hidden></span>
      </div>
      <div class="mf__field">
        <label for="request-phone">Phone <span class="mf__opt">(optional)</span></label>
        <input id="request-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
      </div>
      <div class="mf__field">
        <label for="request-website">Current website <span class="mf__opt">(optional)</span></label>
        <input id="request-website" name="website" type="text" inputmode="url" autocomplete="url" autocapitalize="off" spellcheck="false" />
        <label class="mf__check" for="request-no-website">
          <input id="request-no-website" name="noWebsite" type="checkbox" value="yes" />
          <span>I don't have one</span>
        </label>
      </div>

      <input type="hidden" name="pageUrl" value="" />
      <input type="hidden" name="referrer" value="" />
      <input type="hidden" name="utm_source" value="" />
      <input type="hidden" name="utm_medium" value="" />
      <input type="hidden" name="utm_campaign" value="" />
      <div class="mf__honeypot" aria-hidden="true" inert>
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
      </div>

      <div class="mf__submit">
        <p class="mf__status" data-form-status role="alert" hidden></p>
        <Button type="submit" fullWidthMobile disabled>Send me my free mockup</Button>
        <p class="mf__privacy">I'll only use this to send your mockup and follow up about it. <a href={site.shell.privacyHref}>Privacy</a></p>
      </div>
  </form>
  <noscript><p class="mf__noscript">This form needs JavaScript to check your details. You can still reach me: call or text <a href={site.contact.phoneHref}>{site.contact.phoneDisplay}</a> or email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.</p></noscript>
</Card>

<script>import '../../scripts/mockup-request';</script>

<style>
  .mf__form { display: grid; gap: calc(var(--space) * 3); }
  .mf__field { display: grid; align-content: start; gap: var(--space); min-width: 0; }
  .mf__field[hidden] { display: none; }
  .mf__field > label { font-weight: var(--weight-semibold); line-height: var(--leading-tight); }
  .mf__opt { font-weight: var(--weight-regular); color: var(--color-steel); }
  .mf__field input:not([type="checkbox"]), .mf__field select {
    box-sizing: border-box; width: 100%; min-height: 48px;
    padding: 0 calc(var(--space) * 1.5);
    border: var(--stroke-hair) solid var(--color-rule);
    border-radius: var(--radius-input);
    background: var(--color-white); color: var(--color-charcoal);
    font: inherit; font-size: max(16px, var(--text-body));
  }
  .mf__field select {
    appearance: none; padding-right: calc(var(--space) * 5);
    background-image: linear-gradient(45deg, transparent 50%, var(--color-steel) 50%), linear-gradient(135deg, var(--color-steel) 50%, transparent 50%);
    background-position: calc(100% - 20px) 50%, calc(100% - 15px) 50%;
    background-size: 5px 5px; background-repeat: no-repeat;
  }
  .mf__field input:focus-visible, .mf__field select:focus-visible, .mf__check input:focus-visible {
    outline: var(--stroke-focus) solid var(--color-teal); outline-offset: var(--focus-offset);
  }
  .mf__field input:disabled:not([type="checkbox"]) { background: var(--color-paper); color: var(--color-steel); cursor: not-allowed; }
  .mf__field [aria-invalid="true"] { border-color: var(--color-orange-burnt); }
  .mf__error { color: var(--color-orange-burnt); font-size: var(--text-small); font-weight: var(--weight-medium); }
  .mf__check { display: inline-flex; align-items: center; gap: var(--space); min-height: 44px; cursor: pointer; font-size: var(--text-small); }
  .mf__check input { width: 20px; height: 20px; margin: 0; accent-color: var(--color-teal); }
  .mf__submit { display: grid; gap: calc(var(--space) * 1.5); padding-top: var(--space); border-top: var(--stroke-hair) dashed var(--color-rule); }
  .mf__submit :global(.btn) { width: 100%; margin-top: var(--space); }
  .mf__honeypot { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .mf__status { margin: 0; padding: var(--space) calc(var(--space) * 1.5); background: var(--color-orange-tint); color: var(--color-orange-burnt); border: var(--stroke-hair) solid currentColor; border-radius: var(--radius-input); font-size: var(--text-small); }
  .mf__status[hidden] { display: none; }
  .mf__privacy { margin: 0; font-size: var(--text-small); color: var(--color-steel); }
  .mf__privacy a, .mf__noscript a { color: var(--color-teal); text-decoration: underline; text-underline-offset: var(--underline-offset); }
  .mf__noscript { margin: calc(var(--space) * 2) 0 0; }
  @media (min-width: 640px) {
    .mf__form { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: calc(var(--space) * 2); }
    .mf__field--other, .mf__submit { grid-column: 1 / -1; }
  }
</style>
