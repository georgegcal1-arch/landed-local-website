---
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"div"> & {
  hideBracket?: boolean;
  /** Where the orange square sits. Default "bottom-left"; "top-left" is opt-in (DraftSheet on Home). */
  corner?: "bottom-left" | "top-left";
};
const { class: extra, hideBracket = false, corner = "bottom-left", ...rest } = Astro.props;
---
<div class:list={["corner-frame", corner === "top-left" && "corner-frame--top-left", extra]} {...rest}>
  <div class="corner-frame__content"><slot /></div>
  {!hideBracket && <span class="corner-frame__square" aria-hidden="true"></span>}
</div>

<style>
  .corner-frame {
    position: relative; display: block; box-sizing: border-box; max-width: 100%;
    container-type: inline-size;
    padding-left: var(--frame-inset);
    padding-bottom: var(--frame-inset);
  }
  .corner-frame__content { position: relative; z-index: 1; min-width: 0; }
  .corner-frame__content > :global(img) { display: block; width: 100%; height: auto; }
  .corner-frame__square {
    position: absolute; z-index: 0; pointer-events: none;
    left: 0; bottom: 0;
    width: clamp(var(--square-arm-min), 25cqi, var(--square-arm-max));
    height: clamp(var(--square-arm-min), 25cqi, var(--square-arm-max));
    border-left: var(--stroke-square) solid var(--color-orange);
    border-bottom: var(--stroke-square) solid var(--color-orange);
    border-bottom-left-radius: var(--radius-square-corner);
  }
  .corner-frame--top-left { padding-bottom: 0; padding-top: var(--frame-inset); }
  .corner-frame--top-left .corner-frame__square {
    top: 0; bottom: auto;
    border-bottom: 0; border-top: var(--stroke-square) solid var(--color-orange);
    border-bottom-left-radius: 0; border-top-left-radius: var(--radius-square-corner);
  }
</style>
