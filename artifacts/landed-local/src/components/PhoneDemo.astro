---
import Phone from "lucide-astro/Phone";
import Eyebrow from "./Eyebrow.astro";
import JobTicket from "./JobTicket.astro";
import { site } from "../config/site";

interface Props { class?: string }
const { class: extra } = Astro.props;
const demo = site.heroDemo;
const firstBusiness = demo.messages.findIndex((m) => m.from === "business");
---
<figure class:list={["pd", extra]} data-phone-demo>
  <Eyebrow class="pd__label">{demo.label}</Eyebrow>
  <div class="pd__stage">
    <div class="pd__phone" role="group" aria-label="Example: a missed call answered by text and booked">
      <div class="pd__screen">
        <div class="pd__bar" aria-hidden="true">
          <span class="pd__caller">{demo.callerNumber}</span>
          <span class="pd__tag">New lead</span>
        </div>
        <div class="pd__body" data-pd-scroll tabindex="0" aria-label="Text conversation">
          <p class="pd__missed" data-pd-step>
            <span class="pd__missed-line"><Phone class="pd__icon" aria-hidden="true" />Missed call · {demo.missedCallTime}</span>
            <span>{demo.missedCallNote}</span>
          </p>
          <ol class="pd__msgs">
            {demo.messages.map((m, i) => (
              <li class:list={["pd__msg", `pd__msg--${m.from}`]} data-pd-step data-from={m.from}>
                {i === firstBusiness && <span class="pd__auto">Auto-reply</span>}
                <span class="pd__bubble"><span class="sr-only">{m.from === "business" ? demo.businessName : "Customer"}: </span>{m.text}</span>
              </li>
            ))}
          </ol>
          <div class="pd__typing" data-pd-typing aria-hidden="true"><span></span><span></span><span></span></div>
        </div>
      </div>
    </div>
    <div class="pd__ticket" data-pd-ticket>
      <JobTicket number="0003" title={demo.ticketTitle} plainItems items={[{ label: demo.ticketTime }]} stamp stampText={demo.stamp} />
    </div>
  </div>
  <div class="pd__controls">
    <button type="button" class="pd__replay" data-pd-replay hidden>Replay ↻</button>
  </div>
</figure>

<style>
  .pd {
    --pd-w: calc(var(--space) * 32.5);
    --pd-screen-h: calc(var(--space) * 52);
    --pd-gap: calc(var(--space) * 1.25);
    margin: 0; width: var(--pd-w); max-width: 100%;
    display: flex; flex-direction: column; align-items: center; gap: calc(var(--space) * 2);
  }
  @media (min-width: 768px) { .pd { --pd-w: calc(var(--space) * 37.5); --pd-screen-h: calc(var(--space) * 56); } }
  .pd__label { align-self: flex-start; }
  .pd__stage { position: relative; width: 100%; }

  /* Device: charcoal body, offwhite screen, no hardware details. */
  .pd__phone {
    background: var(--color-charcoal); padding: var(--device-bezel-phone);
    border-radius: var(--device-radius-phone); box-shadow: var(--shadow-card);
  }
  .pd__screen {
    display: flex; flex-direction: column; height: var(--pd-screen-h); overflow: hidden;
    background: var(--color-offwhite); border-radius: calc(var(--device-radius-phone) - var(--device-bezel-phone));
  }
  .pd__bar {
    flex: none; display: flex; justify-content: space-between; align-items: center; gap: var(--space);
    padding: calc(var(--space) * 1.5) calc(var(--space) * 2) var(--space);
    border-bottom: var(--stroke-hair) solid var(--color-rule);
    font-family: var(--font-body); font-size: var(--text-eyebrow); line-height: var(--leading-tight);
  }
  .pd__caller { font-weight: var(--weight-semibold); color: var(--color-charcoal); font-variant-numeric: tabular-nums; }
  .pd__tag { color: var(--color-teal); font-weight: var(--weight-semibold); }
  .pd__body {
    flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
    padding: calc(var(--space) * 2) calc(var(--space) * 1.5) calc(var(--space) * 9);
    display: flex; flex-direction: column; gap: var(--pd-gap);
  }
  .pd__body:focus-visible { outline: var(--stroke-focus) solid var(--color-teal); outline-offset: calc(var(--focus-offset) * -1); }
  .pd__missed {
    margin: 0 0 var(--space); display: grid; justify-items: center; gap: calc(var(--space) * 0.25); text-align: center;
    font-family: var(--font-body); font-size: var(--text-eyebrow); line-height: var(--leading-tight); color: var(--color-steel);
  }
  .pd__missed-line { display: inline-flex; align-items: center; gap: calc(var(--space) * 0.5); font-weight: var(--weight-semibold); }
  .pd__missed :global(.pd__icon) { width: calc(var(--space) * 1.5); height: calc(var(--space) * 1.5); }
  .pd__msgs { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--pd-gap); }
  .pd__body > * { flex-shrink: 0; }
  .pd__msg { display: flex; flex-direction: column; max-width: 84%; }
  .pd__msg--business { align-self: flex-end; align-items: flex-end; }
  .pd__msg--customer { align-self: flex-start; align-items: flex-start; }
  .pd__auto { font-size: var(--text-eyebrow); line-height: var(--leading-tight); color: var(--color-steel); margin-bottom: calc(var(--space) * 0.5); }
  .pd__bubble {
    display: block; padding: var(--space) calc(var(--space) * 1.5);
    font-family: var(--font-body); font-size: var(--text-pill); line-height: 1.4; color: var(--color-charcoal);
  }
  .pd__msg--business .pd__bubble { background: var(--color-teal-tint); border-radius: var(--radius-tag-corner) var(--radius-tag-corner) var(--radius-sharp) var(--radius-tag-corner); }
  .pd__msg--customer .pd__bubble { background: var(--color-white); border: var(--stroke-hair) solid var(--color-rule); border-radius: var(--radius-tag-corner) var(--radius-tag-corner) var(--radius-tag-corner) var(--radius-sharp); }

  .pd__typing { display: none; gap: calc(var(--space) * 0.5); padding: calc(var(--space) * 1.25) calc(var(--space) * 1.5); border-radius: var(--radius-tag-corner); }
  .pd__typing span { width: calc(var(--space) * 0.75); height: calc(var(--space) * 0.75); border-radius: 50%; background: var(--color-steel); animation: pd-dot 900ms ease-in-out infinite; }
  .pd__typing span:nth-child(2) { animation-delay: 150ms; }
  .pd__typing span:nth-child(3) { animation-delay: 300ms; }
  .pd__typing.is-on { display: inline-flex; }
  .pd__typing[data-from="business"] { align-self: flex-end; background: var(--color-teal-tint); }
  .pd__typing[data-from="customer"] { align-self: flex-start; background: var(--color-white); border: var(--stroke-hair) solid var(--color-rule); }
  @keyframes pd-dot { 0%, 100% { opacity: 0.35; transform: translateY(0); } 50% { opacity: 1; transform: translateY(calc(var(--space) * -0.375)); } }

  /* Compact ticket overlapping the phone's bottom edge (scoped here; JobTicket itself unchanged). */
  .pd__ticket { position: relative; z-index: 1; width: 88%; margin: calc(var(--space) * -7) auto 0; }
  .pd__ticket :global(.ticket) { --card-pad: calc(var(--space) * 2); background: var(--color-white); }
  .pd__ticket :global(.ticket__head) { padding-bottom: var(--space); }
  .pd__ticket :global(.ticket__title) { margin: var(--space) 0 calc(var(--space) * 0.5); font-size: var(--text-body); }
  .pd__ticket :global(.ticket__items) { font-size: var(--text-small); }
  .pd__ticket :global(.ticket__head-meta) { display: none; }
  .pd__ticket :global(.ticket__stamp-row) { justify-content: flex-end; padding-top: calc(var(--space) * 1.5); }
  .pd__ticket :global(.ticket__stamp) { font-size: var(--text-pill); padding: calc(var(--space) * 0.5) var(--space); }

  .pd__controls { min-height: var(--button-min-h); }
  .pd__replay {
    background: none; border: 0; padding: var(--space) calc(var(--space) * 0.5); cursor: pointer; min-height: var(--button-min-h);
    font-family: var(--font-body); font-weight: var(--weight-semibold); font-size: var(--text-small);
    color: var(--color-teal); text-decoration: underline; text-decoration-thickness: var(--stroke-underline); text-underline-offset: var(--underline-offset);
  }
  .pd__replay[hidden] { display: none; }
  .pd__replay:focus-visible { outline: var(--stroke-focus) solid var(--color-teal); outline-offset: var(--focus-offset); border-radius: var(--radius-sharp); }
  :global([data-tone="dark"]) .pd__replay { color: var(--color-teal-light); }

  /* Armed (JS + motion allowed): steps hide until their turn. Without JS the finished chat shows. */
  .pd.is-armed [data-pd-step]:not(.is-shown) { display: none; }
  .pd.is-armed [data-pd-step].is-shown { animation: pd-in 320ms var(--ease-out) both; }
  .pd.is-armed .pd__ticket:not(.is-shown) { opacity: 0; transform: translateY(calc(var(--space) * 4)); }
  .pd.is-armed .pd__ticket { transition: opacity var(--dur-check) var(--ease-out), transform var(--dur-ruler) var(--ease-out); }
  .pd.is-armed .pd__ticket:not(.is-stamped) :global(.ticket__stamp) { opacity: 0; }
  .pd.is-armed .pd__ticket.is-stamped :global(.ticket__stamp) { animation: pd-stamp var(--dur-check) var(--ease-out) both; }
  @keyframes pd-in { from { opacity: 0; transform: translateY(var(--space)); } to { opacity: 1; transform: none; } }
  @keyframes pd-stamp {
    from { opacity: 0; transform: translateY(calc(var(--space) * -0.5)) rotate(calc(var(--stamp-rotate) * 2)) scale(1.4); }
    to { opacity: 1; transform: translateY(calc(var(--space) * -0.5)) rotate(var(--stamp-rotate)) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pd__typing { display: none !important; }
    .pd__replay { display: none !important; }
  }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
</style>

<script>
  const query = window.matchMedia("(prefers-reduced-motion: reduce)");
  const TYPE_MS = 600, GAP_MS = 900, FIRST_MS = 600;

  function setup(root: HTMLElement) {
    if (root.dataset.pdInit) return;
    root.dataset.pdInit = "1";
    const scroller = root.querySelector<HTMLElement>("[data-pd-scroll]")!;
    const steps = [...root.querySelectorAll<HTMLElement>("[data-pd-step]")];
    const typing = root.querySelector<HTMLElement>("[data-pd-typing]")!;
    const ticket = root.querySelector<HTMLElement>("[data-pd-ticket]")!;
    const replay = root.querySelector<HTMLButtonElement>("[data-pd-replay]")!;
    let timers: number[] = [];
    let observer: IntersectionObserver | null = null;
    let played = false;

    const clear = () => { timers.forEach(clearTimeout); timers = []; typing.classList.remove("is-on"); };
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const toBottom = () => { if (!query.matches) scroller.scrollTop = scroller.scrollHeight; };

    function finish() {
      clear();
      root.classList.remove("is-armed");
      steps.forEach((s) => s.classList.add("is-shown"));
      ticket.classList.add("is-shown", "is-stamped");
      replay.hidden = true;
    }
    function reset() {
      clear();
      root.classList.add("is-armed");
      steps.forEach((s) => s.classList.remove("is-shown"));
      ticket.classList.remove("is-shown", "is-stamped");
      scroller.scrollTop = 0;
    }
    function play() {
      reset();
      replay.hidden = false;
      steps[0].classList.add("is-shown");
      let t = FIRST_MS;
      steps.slice(1).forEach((step) => {
        at(t, () => { typing.dataset.from = step.dataset.from; typing.classList.add("is-on"); toBottom(); });
        t += TYPE_MS;
        at(t, () => { typing.classList.remove("is-on"); step.classList.add("is-shown"); toBottom(); });
        t += GAP_MS;
      });
      at(t, () => ticket.classList.add("is-shown"));
      at(t + 600, () => ticket.classList.add("is-stamped"));
    }

    replay.addEventListener("click", () => { if (!query.matches) play(); });
    query.addEventListener("change", () => {
      if (query.matches) { observer?.disconnect(); finish(); }
      else if (played) replay.hidden = false;
    });

    if (query.matches || !("IntersectionObserver" in window)) { finish(); return; }
    reset();
    observer = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting) || played) return;
      played = true;
      observer?.disconnect();
      play();
    }, { threshold: 0.35 });
    observer.observe(root);
  }

  document.querySelectorAll<HTMLElement>("[data-phone-demo]").forEach(setup);
</script>
