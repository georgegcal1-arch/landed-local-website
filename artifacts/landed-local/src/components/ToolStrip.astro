---
import Eyebrow from "./Eyebrow.astro";
import { site } from "../config/site";
interface Props {
  class?: string;
  /** "loop" scrolls (light grounds); "band" is a static centered row for a charcoal Section. */
  variant?: "loop" | "band";
  /** Heading level for the band variant. */
  headingAs?: "h2" | "h3";
  /** Loop only. "lg" is the large charcoal-band loop: centered heading, big names, orange dots, edge fades. */
  size?: "default" | "lg";
}
const { class: extra, variant = "loop", headingAs: Heading = "h2", size = "default" } = Astro.props;
const lg = size === "lg";
const { show, label, names } = site.tools;
---
{show && variant === "band" && (
  <div class:list={["tools-band", extra]} data-reveal>
    <Heading class="tools-band__heading">{label}</Heading>
    <ul class="tools-band__list">
      {names.map((n) => <li class="tools-band__item">{n}</li>)}
    </ul>
  </div>
)}
{show && variant === "loop" && (
  <div class:list={["tools", { "tools--lg": lg }, extra]} data-tool-strip>
    <div class="tools__head">
      {lg ? <Heading class="tools__heading">{label}</Heading> : <Eyebrow as="p">{label}</Eyebrow>}
      <button type="button" class="tools__toggle" aria-pressed="false" hidden data-tool-toggle>
        <span class="tools__toggle-icon" aria-hidden="true"></span>
        <span data-tool-toggle-label>Pause</span><span class="visually-hidden"> tool names scrolling</span>
      </button>
    </div>
    <div class="tools__viewport">
      <div class="tools__track">
        <ul class="tools__list">
          {names.map((n) => <li class="tools__item"><span>{n}</span>{lg ? <span class="tools__dot" aria-hidden="true"></span> : <span class="tools__tick" aria-hidden="true"></span>}</li>)}
        </ul>
        <ul class="tools__list tools__list--copy" aria-hidden="true">
          {names.map((n) => <li class="tools__item"><span>{n}</span>{lg ? <span class="tools__dot"></span> : <span class="tools__tick"></span>}</li>)}
        </ul>
      </div>
    </div>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>("[data-tool-strip]").forEach((strip) => {
    const btn = strip.querySelector<HTMLButtonElement>("[data-tool-toggle]");
    const text = strip.querySelector<HTMLElement>("[data-tool-toggle-label]");
    const viewport = strip.querySelector<HTMLElement>(".tools__viewport");
    if (!btn || !text || !viewport) return;
    btn.hidden = false;
    const set = (paused: boolean) => {
      strip.classList.toggle("is-paused", paused);
      btn.setAttribute("aria-pressed", String(paused));
      text.textContent = paused ? "Resume" : "Pause";
    };
    btn.addEventListener("click", () => set(!strip.classList.contains("is-paused")));
    viewport.addEventListener("click", () => set(!strip.classList.contains("is-paused")));
    strip.classList.add("is-enhanced");
  });
</script>

<style>
  .tools { display: grid; gap: calc(var(--space) * 2); }
  .tools__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space) calc(var(--space) * 2); }
  .tools__toggle {
    display: inline-flex; align-items: center; gap: var(--space); min-height: var(--button-min-h);
    padding: 0 calc(var(--space) * 2); background: transparent; color: var(--color-steel);
    border: var(--stroke-hair) solid var(--color-rule); border-radius: var(--radius-sharp) var(--radius-sharp) var(--radius-sharp) var(--radius-corner);
    font-family: var(--font-body); font-weight: var(--weight-medium); font-size: var(--text-eyebrow); cursor: pointer;
  }
  .tools__toggle[hidden] { display: none; }
  .tools__toggle:focus-visible { outline: var(--stroke-focus) solid var(--color-teal); outline-offset: var(--focus-offset); }
  .tools__toggle-icon { width: calc(var(--space) * 1.25); height: calc(var(--space) * 1.5); border-inline: var(--stroke-outline) solid currentColor; }
  .tools__toggle[aria-pressed="true"] .tools__toggle-icon {
    border: 0; width: 0; height: 0;
    border-block: calc(var(--space) * 0.75) solid transparent; border-left: calc(var(--space) * 1.25) solid currentColor;
  }
  :global([data-tone="dark"]) .tools__toggle { color: var(--color-rule); border-color: var(--color-ruler-rule-dark); }
  .visually-hidden { position: absolute; width: var(--stroke-hair); height: var(--stroke-hair); overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .tools__viewport { overflow: hidden; border-block: var(--stroke-hair) solid var(--color-rule); padding-block: calc(var(--space) * 2); }
  :global([data-tone="dark"]) .tools__viewport { border-color: var(--color-ruler-rule-dark); }
  .tools__track { display: flex; }
  .tools__list { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; flex: none; flex-wrap: wrap; row-gap: var(--space); max-width: 100%; }
  .tools__list--copy { display: none; }
  .tools__item {
    display: inline-flex; align-items: center; gap: calc(var(--space) * 3); padding-right: calc(var(--space) * 3);
    font-family: var(--font-body); font-weight: var(--weight-medium); font-size: var(--text-body); white-space: nowrap; color: var(--color-charcoal);
  }
  :global([data-tone="dark"]) .tools__item { color: var(--color-offwhite); }
  .tools__tick { width: var(--stroke-ruler); height: var(--ruler-tick-mid); background: var(--color-ruler-rule-light); }
  :global([data-tone="dark"]) .tools__tick { background: var(--color-ruler-rule-dark); }

  @media (prefers-reduced-motion: no-preference) {
    .tools.is-enhanced .tools__track { width: max-content; animation: tools-loop calc(var(--dur-ruler) * 64) linear infinite; }
    .tools.is-enhanced .tools__list { flex-wrap: nowrap; max-width: none; }
    .tools.is-enhanced .tools__list--copy { display: flex; }
    /* Pause follows the toggle state only, so keyboard Resume restarts it while the button keeps focus. */
    .tools.is-paused .tools__track { animation-play-state: paused; }
    .tools--lg.tools.is-enhanced .tools__track { animation-duration: var(--dur-tools-lg); }
    .tools--lg.tools.is-enhanced .tools__list { justify-content: flex-start; }
    .tools--lg.tools.is-enhanced .tools__viewport {
      -webkit-mask-image: linear-gradient(90deg, transparent, currentColor var(--tools-lg-fade), currentColor calc(100% - var(--tools-lg-fade)), transparent);
      mask-image: linear-gradient(90deg, transparent, currentColor var(--tools-lg-fade), currentColor calc(100% - var(--tools-lg-fade)), transparent);
    }
    .tools--lg.tools.is-enhanced .tools__list .tools__item:last-child .tools__dot { display: block; }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .tools__viewport:hover .tools__track { animation-play-state: paused; }
  }
  /* Band: static, centered, wraps. No loop, no copy, no toggle. */
  .tools-band { display: grid; justify-items: center; gap: calc(var(--space) * 4); text-align: center; }
  .tools-band__heading {
    margin: 0; font-family: var(--font-display); font-weight: var(--weight-bold);
    font-size: clamp(24px, 3vw, 32px); line-height: var(--leading-tight); color: var(--color-white);
  }
  .tools-band__list {
    list-style: none; margin: 0; padding: calc(var(--space) * 3) 0 0; display: flex; flex-wrap: wrap; justify-content: center;
    gap: calc(var(--space) * 2) 0; max-width: 100%; border-top: var(--stroke-hair) solid var(--color-ruler-rule-dark);
  }
  .tools-band__item {
    display: inline-flex; align-items: center; padding-inline: calc(var(--space) * 2.5);
    font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: clamp(20px, 2.1vw, 26px);
    line-height: var(--leading-tight); color: var(--color-offwhite); white-space: nowrap;
  }
  .tools-band__item + .tools-band__item { border-left: var(--stroke-ruler) solid var(--color-ruler-rule-dark); }
  @media (max-width: 639px) {
    .tools-band__list { gap: calc(var(--space) * 1.5) 0; }
    .tools-band__item { padding-inline: calc(var(--space) * 1.75); }
    .tools-band__item + .tools-band__item { border-left: 0; }
    .tools-band__item:not(:last-child)::after { content: ""; width: var(--stroke-ruler); height: var(--ruler-tick-mid); margin-left: calc(var(--space) * 3.5); margin-right: calc(var(--space) * -1.75); background: var(--color-ruler-rule-dark); }
  }
  /* Large loop for the charcoal band */
  .tools--lg { gap: calc(var(--space) * 4); }
  .tools--lg .tools__head { flex-direction: column; justify-content: center; text-align: center; gap: calc(var(--space) * 2); }
  .tools--lg .tools__heading {
    margin: 0; font-family: var(--font-display); font-weight: var(--weight-heavy);
    font-size: var(--tools-lg-heading); line-height: var(--leading-tight); color: var(--color-white);
  }
  .tools--lg .tools__toggle { order: 2; }
  .tools--lg .tools__viewport { border-block: 0; padding-block: var(--space); cursor: pointer; }
  .tools--lg .tools__track { justify-content: center; }
  .tools--lg .tools__list { justify-content: center; row-gap: calc(var(--space) * 2); }
  .tools--lg .tools__item {
    gap: var(--tools-lg-half-gap); padding-right: var(--tools-lg-half-gap);
    font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--tools-lg-size);
    line-height: var(--leading-tight); color: var(--color-offwhite);
  }
  .tools--lg .tools__item:last-child .tools__dot { display: none; }
  .tools__dot { flex: none; width: var(--tools-lg-dot); height: var(--tools-lg-dot); border-radius: 50%; background: var(--color-orange); }
  @keyframes tools-loop { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .tools__track { width: auto; }
    .tools__list { flex-wrap: wrap; row-gap: var(--space); }
    .tools__list--copy, .tools__toggle { display: none; }
  }
</style>
