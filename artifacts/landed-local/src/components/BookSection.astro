---
import Section from "./Section.astro";
import Eyebrow from "./Eyebrow.astro";
import JobTicket from "./JobTicket.astro";
import CheckList from "./CheckList.astro";
import RulerDivider from "./RulerDivider.astro";
import BookingEmbed from "./BookingEmbed.astro";
import { site } from "../config/site";

interface Props { headingAs?: "h1" | "h2"; id?: string }
const { headingAs: Heading = "h1", id = "book" } = Astro.props;
const { booking, business, contact } = site;
const handy = ["Calls a week", "Average job value", "How leads come in", "What happens to calls after hours"];
---
<Section id={id} bg="offwhite" blueprint class="book-section">
  <div class="book-top">
    <div class="book-intro">
      <Eyebrow>BOOK A CALL</Eyebrow>
      <Heading class="book-heading">Book a Consultation</Heading>
      <p class="book-sub">30 minutes · No pressure · Clear numbers</p>
      <div class="book-handy">
        <h2 class="book-handy__h">Have these handy</h2>
        <CheckList items={handy} />
      </div>
      <p class="book-capacity">I only take on a few new companies at a time.</p>
    </div>
    <div class="book-ticket" data-reveal>
      <JobTicket number="0001" title="Consultation" titleAs="h2" items={booking.callItems.map((label) => ({ label }))} total={{ label: "30 min", value: `With ${business.ownerFirst}` }} />
    </div>
  </div>
</Section>
<RulerDivider variant="orange" />
<Section bg="offwhite" class="book-cal-section">
  <BookingEmbed variant="inline" />
  <p class="book-call">Google Meet or phone. Or <a class="accent" href={contact.phoneHref}>call</a> or <a class="accent" href={contact.smsHref}>text</a> {business.ownerFirst}: <a class="accent" href={contact.phoneHref}>{contact.phoneDisplay}</a></p>
</Section>

<style>
  :global(.book-section) { scroll-margin-top: calc(var(--header-h) + var(--space) * 2); }
  .book-top { display: grid; gap: calc(var(--space) * 5); align-items: start; }
  .book-heading { margin: calc(var(--space) * 1.5) 0 var(--space); }
  .book-sub { margin: 0; font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--hero-text-lead); color: var(--color-steel); }
  .book-handy { margin-top: calc(var(--space) * 4); padding-top: calc(var(--space) * 3); border-top: var(--stroke-hair) solid var(--color-rule); }
  .book-handy__h { margin: 0 0 calc(var(--space) * 2); font-size: var(--text-h3); }
  .book-capacity { margin: calc(var(--space) * 3) 0 0; font-size: var(--text-small); color: var(--color-steel); }
  .book-ticket { min-width: 0; }
  @media (min-width: 900px) {
    .book-top { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); column-gap: calc(var(--space) * 8); }
    .book-ticket { transform: rotate(var(--hero-ticket-rotate)); margin-top: calc(var(--space) * 2); }
  }
  :global(.book-cal-section) { padding-top: calc(var(--space) * 6); }
  .book-call { margin: calc(var(--space) * 3) 0 0; text-align: center; font-size: var(--text-small); }
</style>
