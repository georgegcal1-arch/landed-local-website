---
import Eyebrow from "./Eyebrow.astro";
export interface TicketItem { label: string; value?: string }
interface Props {
  number: string;
  title: string;
  items: TicketItem[];
  total?: { label?: string; value: string; previousValue?: string };
  stamp?: boolean | string;
  /** "inline" (default) sits in the total row; "corner" overlaps the bottom-right; "top-right" sits in the header. */
  stampPlacement?: "inline" | "corner" | "top-right";
  class?: string;
}
const { number, title, items, total, stamp = false, stampPlacement = "inline", class: extra } = Astro.props;
const corner = stamp && stampPlacement === "corner";
const topRight = stamp && stampPlacement === "top-right";
const stampText = typeof stamp === "string" ? stamp : "APPROVED";
---
<article class:list={["ticket", { "ticket--stamp-corner": corner }, extra]} data-tone="light">
  <header class="ticket__head">
    <Eyebrow as="span">Work order</Eyebrow>
    <div class:list={["ticket__head-meta", { "ticket__head-meta--stamp": topRight }]}>
      {topRight && <div class="ticket__stamp ticket__stamp--top-right" aria-label={stampText}><span>{stampText}</span></div>}
      <span class="ticket__num">{number.startsWith("#") ? number : `No. ${number}`}</span>
    </div>
  </header>
  <h3 class="ticket__title">{title}</h3>
  <ul class="ticket__items" data-reveal>
    {items.map((item, i) => (
      <li class="ticket__item" style={`--i:${i}`}>
        <svg class="ticket__check" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12.5 L9.5 18 L20 5" pathLength="1" /></svg>
        <span class="ticket__label">{item.label}</span>
        {item.value && <span class="ticket__leader" aria-hidden="true"></span>}
        {item.value && <span class="ticket__value price">{item.value}</span>}
      </li>
    ))}
  </ul>
  {total && (
    <div class:list={["ticket__total", { "ticket__total--previous": total.previousValue }]}>
      <span>{total.label ?? "Total"}</span>
      {stamp && !corner && !topRight && <div class="ticket__stamp" aria-label={stampText}><span>{stampText}</span></div>}
      {total.previousValue && !stamp && <span class="ticket__total-spacer" aria-hidden="true"></span>}
      {total.previousValue && <span class="ticket__previous-price price">{total.previousValue}</span>}
      <span class="ticket__value price">{total.value}</span>
    </div>
  )}
  {corner && <div class="ticket__stamp ticket__stamp--corner" aria-label={stampText}><span>{stampText}</span></div>}
  {stamp && !total && !corner && !topRight && <div class="ticket__stamp-row"><div class="ticket__stamp" aria-label={stampText}><span>{stampText}</span></div></div>}
</article>
<script>import "../scripts/motion";</script>

<style>
  .ticket {
    position: relative; background: var(--color-paper); color: var(--color-charcoal);
    border: var(--stroke-hair) solid var(--color-rule);
    border-radius: var(--radius-sharp) var(--radius-sharp) var(--radius-sharp) var(--radius-corner);
    box-shadow: var(--shadow-card); padding: var(--card-pad);
  }
  /* Local foreground reset so dark Section selectors never leak onto paper. */
  .ticket :global(:is(h1, h2, h3, p, li, span)) { color: var(--color-charcoal); }
  .ticket .ticket__num { color: var(--color-steel); }
  .ticket :global(.eyebrow), .ticket :global(.eyebrow span) { color: var(--color-orange-burnt); }
  .ticket .ticket__stamp, .ticket .ticket__stamp span { color: var(--color-teal); }
  .ticket__label { overflow-wrap: anywhere; }
  :global([data-bg="paper"]) .ticket { background: var(--color-white); }
  .ticket__head { display: flex; justify-content: space-between; align-items: center; gap: calc(var(--space) * 2);
    padding-bottom: calc(var(--space) * 2); border-bottom: var(--stroke-hair) dashed var(--color-steel); }
  .ticket__head-meta { display: flex; align-items: center; justify-content: flex-end; gap: var(--space); }
  .ticket__head-meta--stamp { flex-direction: column; align-items: flex-end; gap: calc(var(--space) * 0.5); }
  .ticket__num { font-family: var(--font-body); font-weight: var(--weight-semibold); font-size: var(--text-eyebrow); font-variant-numeric: tabular-nums; color: var(--color-steel); letter-spacing: 0; }
  .ticket__stamp--top-right { align-self: flex-end; }
  .ticket__title { margin: calc(var(--space) * 2) 0 calc(var(--space) * 2.5); font-size: var(--text-h3); line-height: var(--leading-tight); }
  .ticket__items { list-style: none; margin: 0; padding: 0; display: grid; gap: calc(var(--space) * 1.25); }
  .ticket__item { display: flex; align-items: baseline; gap: var(--space); }
  .ticket__check { flex: none; width: var(--check-size); height: var(--check-size); align-self: center; }
  .ticket__check path { fill: none; stroke: var(--color-teal); stroke-width: var(--stroke-check); stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  :global(html.motion-ok) .ticket__items:not(.is-in) .ticket__check path { stroke-dashoffset: 1; }
  :global(html.motion-ok) .ticket__items.is-in .ticket__check path { transition: stroke-dashoffset var(--dur-check) var(--ease-out); transition-delay: calc(var(--i, 0) * var(--stagger-check)); }
  .ticket__label { flex: none; max-width: 70%; }
  .ticket__leader { flex: 1; min-width: calc(var(--space) * 2); border-bottom: var(--leader-dot) dotted var(--color-steel); transform: translateY(calc(var(--space) * -0.5)); }
  .ticket__value { flex: none; }
  .ticket__total { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space); margin-top: calc(var(--space) * 2.5); padding-top: calc(var(--space) * 2);
    border-top: var(--stroke-outline) solid var(--color-charcoal); font-weight: var(--weight-semibold); }
  .ticket__total--previous { grid-template-columns: auto minmax(0, 1fr) auto auto; }
  .ticket__total > :first-child { overflow-wrap: anywhere; }
  .ticket__total > :last-child { justify-self: end; white-space: nowrap; }
  .ticket__total .price { font-size: var(--text-h3); }
  .ticket__total--previous .ticket__previous-price { color: var(--color-steel); font-size: var(--text-body); text-decoration: line-through; white-space: nowrap; }
  .ticket__total--previous .ticket__value.price { color: var(--color-charcoal); font-size: var(--pricing-main-size); line-height: var(--leading-tight); }
  .ticket__stamp {
    position: relative; justify-self: center; z-index: 1;
    transform: translateY(calc(var(--space) * -0.5)) rotate(var(--stamp-rotate)); pointer-events: none;
    border: var(--stroke-focus) solid var(--color-teal); background: var(--stamp-bg); color: var(--color-teal);
    border-radius: var(--radius-sharp) var(--radius-sharp) var(--radius-sharp) var(--radius-corner);
    padding: var(--space) calc(var(--space) * 2);
    font-family: var(--font-display); font-weight: var(--weight-heavy); font-size: var(--text-stamp); letter-spacing: var(--tracking-stamp);
  }
  .ticket__stamp--corner { position: absolute; right: calc(var(--space) * -1); bottom: calc(var(--space) * -4); transform: rotate(var(--stamp-rotate)); }
  .ticket__stamp-row { display: flex; justify-content: center; padding-top: var(--space); }
</style>
