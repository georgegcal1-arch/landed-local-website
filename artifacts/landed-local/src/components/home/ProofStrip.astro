---
import Section from "../Section.astro";
import RulerDivider from "../RulerDivider.astro";
import { site } from "../../config/site";

const facts = [
  "Live in 7 days",
  "You own your site and domain",
  `$${site.pricing.standard.toLocaleString("en-US")} one time, no required monthly fee`,
  "Based in Columbus, Ohio",
];
---

<RulerDivider />
<Section id="proof" bg="offwhite" class="proof-strip" aria-label="Landed Local facts">
  <ul class="proof-strip__list">
    {facts.map((fact) => (
      <li class="proof-strip__item">
        <svg class="proof-strip__check" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4 12.5 L9.5 18 L20 5" />
        </svg>
        <span>{fact}</span>
      </li>
    ))}
  </ul>
</Section>

<style>
  .proof-strip { padding-block: calc(var(--space) * 4); scroll-margin-top: calc(var(--header-h) + var(--space) * 2); }
  .proof-strip__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(var(--space) * 3) calc(var(--space) * 2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .proof-strip__item {
    display: flex;
    align-items: center;
    gap: var(--space);
    min-width: 0;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
  }
  .proof-strip__check { flex: none; width: var(--check-size); height: var(--check-size); fill: none; stroke: var(--color-teal); stroke-width: var(--stroke-check); stroke-linecap: round; stroke-linejoin: round; }
  @media (min-width: 900px) {
    .proof-strip__list { grid-template-columns: 1fr 1.5fr 1.8fr 1.2fr; gap: 0; }
    .proof-strip__item { position: relative; padding-inline: var(--space); }
    .proof-strip__item:first-child { padding-left: 0; }
    .proof-strip__item:last-child { padding-right: 0; }
    .proof-strip__item:nth-child(n + 2)::before {
      content: "";
      position: absolute;
      left: 0;
      width: var(--stroke-ruler);
      height: var(--ruler-tick-major);
      background: var(--color-ruler-rule-light);
    }
  }
</style>
