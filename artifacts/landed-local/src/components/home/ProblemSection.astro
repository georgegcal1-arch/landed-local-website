---
import CircleHelp from "lucide-astro/CircleHelp";
import SearchX from "lucide-astro/SearchX";
import Smartphone from "lucide-astro/Smartphone";
import Card from "../Card.astro";
import Eyebrow from "../Eyebrow.astro";
import Section from "../Section.astro";

const problems = [
  {
    icon: SearchX,
    title: "No website",
    copy: "They find your reviews but nothing else, so they call the next company that has a site.",
  },
  {
    icon: Smartphone,
    title: "Hard to use on a phone",
    copy: "Tiny text, no call button, slow to load. Most of your visitors are on their phone.",
  },
  {
    icon: CircleHelp,
    title: "No idea if it's working",
    copy: "You can't tell how many calls your site brings in, or how many you miss.",
  },
];
---

<Section id="the-problem" bg="paper" class="problem">
  <Eyebrow>The problem</Eyebrow>
  <h2 class="problem__heading">Your customers look you up before they call.</h2>
  <p class="problem__intro">Most people check Google first. Here's what usually stops them from calling you:</p>
  <div class="problem__cards">
    {problems.map(({ icon: Icon, title, copy }) => (
      <Card as="article" class="problem__card">
        <span class="problem__icon"><Icon size={24} strokeWidth={2} aria-hidden="true" /></span>
        <h3 class="problem__card-title">{title}</h3>
        <p>{copy}</p>
      </Card>
    ))}
  </div>
  <p class="problem__closing">Your reviews already prove you do great work. Your website should too.</p>
</Section>

<style>
  .problem__heading { margin: calc(var(--space) * 2) 0 var(--space); }
  .problem__intro { margin: 0; }
  .problem__cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: calc(var(--space) * 3);
    margin-top: calc(var(--space) * 4);
    align-items: stretch;
  }
  .problem__card { height: 100%; }
  .problem__icon {
    display: grid;
    place-items: center;
    width: var(--problem-icon-size);
    height: var(--problem-icon-size);
    border-radius: var(--radius-sharp) var(--radius-sharp) var(--radius-sharp) var(--radius-corner);
    background: var(--color-orange-tint);
    color: var(--color-orange-burnt);
  }
  .problem__card-title { margin: calc(var(--space) * 2) 0 var(--space); }
  .problem__card p { margin: 0; }
  .problem__closing {
    max-width: none;
    margin: calc(var(--space) * 4) auto 0;
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--problem-closing-size);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
  }
  @media (min-width: 768px) {
    .problem__cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .problem__card { display: flex; flex-direction: column; }
  }
</style>
