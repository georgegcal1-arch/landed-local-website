---
import Button from "../Button.astro";
import Eyebrow from "../Eyebrow.astro";
import Section from "../Section.astro";
import { site } from "../../config/site";

const { contact } = site;
---

<Section id="final-cta" bg="orange-tint" class="home-cta">
  <div class="home-cta__content">
    <Eyebrow>Free mockup</Eyebrow>
    <h2>Want to see your new site first?</h2>
    <p class="home-cta__intro">Tell me your business name and I'll build a free mockup with your name on it. No call needed.</p>

    <form class="home-cta__form" data-mockup-prefill-form novalidate>
      <div class="home-cta__field">
        <label for="mockup-name">Your name</label>
        <input id="mockup-name" name="name" type="text" autocomplete="name" required aria-describedby="mockup-name-error" />
        <span class="home-cta__error" id="mockup-name-error" hidden></span>
      </div>
      <div class="home-cta__field">
        <label for="mockup-business">Business name</label>
        <input id="mockup-business" name="businessName" type="text" autocomplete="organization" required aria-describedby="mockup-business-error" />
        <span class="home-cta__error" id="mockup-business-error" hidden></span>
      </div>
      <div class="home-cta__field">
        <label for="mockup-email">Email</label>
        <input id="mockup-email" name="email" type="email" autocomplete="email" required aria-describedby="mockup-email-error" />
        <span class="home-cta__error" id="mockup-email-error" hidden></span>
      </div>
      <Button type="submit" fullWidthMobile>Send me my free mockup</Button>
      <p class="home-cta__form-error" data-form-error role="alert" hidden>Couldn't save your details. Please try again.</p>
    </form>

    <p class="home-cta__contact">Prefer to talk? <a href={contact.phoneHref}>Call or text {contact.phoneDisplay}</a></p>
  </div>
</Section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-mockup-prefill-form]");

  if (form) {
    const nameInput = form.querySelector<HTMLInputElement>("#mockup-name")!;
    const businessInput = form.querySelector<HTMLInputElement>("#mockup-business")!;
    const emailInput = form.querySelector<HTMLInputElement>("#mockup-email")!;
    const formError = form.querySelector<HTMLElement>("[data-form-error]")!;
    const fieldErrors = [
      { input: nameInput, node: form.querySelector<HTMLElement>("#mockup-name-error")!, message: "Please enter your name." },
      { input: businessInput, node: form.querySelector<HTMLElement>("#mockup-business-error")!, message: "Please enter your business name." },
      { input: emailInput, node: form.querySelector<HTMLElement>("#mockup-email-error")!, message: "Enter a valid email address." },
    ];

    const showFieldError = (input: HTMLInputElement, node: HTMLElement, message: string | null) => {
      node.textContent = message ?? "";
      node.hidden = !message;
      if (message) input.setAttribute("aria-invalid", "true");
      else input.removeAttribute("aria-invalid");
    };

    form.addEventListener("input", (event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement)) return;
      const field = fieldErrors.find((entry) => entry.input === input);
      if (field) showFieldError(field.input, field.node, null);
      formError.hidden = true;
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const name = nameInput.value.trim();
      const businessName = businessInput.value.trim();
      const email = emailInput.value.trim();
      const emailIsValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

      showFieldError(nameInput, fieldErrors[0].node, name ? null : fieldErrors[0].message);
      showFieldError(businessInput, fieldErrors[1].node, businessName ? null : fieldErrors[1].message);
      showFieldError(emailInput, fieldErrors[2].node, emailIsValid ? null : fieldErrors[2].message);
      formError.hidden = true;

      const firstInvalid = fieldErrors.find(({ input }) => input.getAttribute("aria-invalid") === "true");
      if (firstInvalid) {
        firstInvalid.input.focus();
        return;
      }

      try {
        sessionStorage.setItem("mockupPrefill", JSON.stringify({ name, businessName, email }));
        window.location.assign("/get-a-mockup");
      } catch {
        formError.hidden = false;
      }
    });
  }
</script>

<style>
  .home-cta__content { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .home-cta h2 { margin: calc(var(--space) * 2) 0 var(--space); }
  .home-cta__intro { margin: 0; }
  .home-cta__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: calc(var(--space) * 2);
    width: 100%;
    max-width: 1040px;
    margin-top: calc(var(--space) * 4);
    text-align: left;
  }
  .home-cta__field { display: grid; align-content: start; gap: var(--space); min-width: 0; }
  .home-cta__field label { font-weight: var(--weight-semibold); }
  .home-cta__field input {
    box-sizing: border-box;
    width: 100%;
    min-height: 48px;
    padding: 0 calc(var(--space) * 1.5);
    border: var(--stroke-hair) solid var(--color-rule);
    border-radius: var(--radius-input);
    background: var(--color-white);
    color: var(--color-charcoal);
    font: inherit;
  }
  .home-cta__field input:focus-visible {
    outline: var(--stroke-focus) solid var(--color-teal);
    outline-offset: var(--focus-offset);
  }
  .home-cta__field input[aria-invalid="true"] { border-color: var(--color-orange-burnt); }
  .home-cta__error, .home-cta__form-error { margin: 0; color: var(--color-orange-burnt); font-size: var(--text-small); }
  .home-cta__form-error { grid-column: 1 / -1; text-align: center; }
  .home-cta__contact { margin: calc(var(--space) * 3) 0 0; }
  .home-cta__contact a {
    color: var(--color-teal);
    text-decoration: underline;
    text-decoration-thickness: var(--stroke-underline);
    text-underline-offset: var(--underline-offset);
  }
  @media (min-width: 640px) {
    .home-cta__form { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .home-cta__form :global(.btn) { grid-column: 1 / -1; justify-self: center; }
  }
  @media (min-width: 900px) {
    .home-cta__form { grid-template-columns: repeat(3, minmax(0, 1fr)) auto; align-items: end; }
    .home-cta__form :global(.btn) { grid-column: auto; white-space: nowrap; }
  }
</style>
