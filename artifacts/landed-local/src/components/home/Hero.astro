---
import OptimizedImage from "../OptimizedImage.astro";
import Phone from "lucide-astro/Phone";
import Section from "../Section.astro";
import Eyebrow from "../Eyebrow.astro";
import PencilMark from "../PencilMark.astro";
import Button from "../Button.astro";
import CornerFrame from "../CornerFrame.astro";
import JobTicket from "../JobTicket.astro";
import Pill from "../Pill.astro";
import DeviceMock from "./DeviceMock.astro";
import { site } from "../../config/site";

const { hero, photos, pricing, offer, contact, business, shell, samples } = site;
const usd = (n: number) => "$" + n.toLocaleString("en-US");
const secondary = samples.length > 0 ? { label: "See sample sites", href: "#samples" } : { label: "See what's included", href: "#what-you-get" };
const phone = hero.devicePhoneImage;
const laptop = hero.deviceLaptopImage;
// Neither image: preview both as placeholders. Phone-only: solo phone. Otherwise laptop (with phone if set).
const showLaptop = !!laptop || !phone;
const showPhone = !!phone || !laptop;
const solo = showPhone && !showLaptop;
const linkAttrs = hero.sampleUrl ? { href: hero.sampleUrl, target: "_blank", rel: "noopener noreferrer", "aria-label": "Open the sample site in a new tab" } : {};
const DevTag = hero.sampleUrl ? "a" : "div";
const sampleAlt = "Sample site for a fictional local business";
---
<Section bg="offwhite" blueprint class="hero" aria-labelledby="hero-title">
  <div class="hero__grid">
    <div class="hero__text">
      <Eyebrow>Websites for {business.city} service businesses</Eyebrow>
      <h1 id="hero-title" class="hero__h1">
        <span class="hero__line">Get found.</span>
        <span class="hero__line">Get the call.</span>
        <span class="hero__line"><PencilMark>Get the job.</PencilMark></span>
      </h1>
      <p class="hero__lead">I build fast, phone-first websites for plumbers, electricians and other local trades. Live in {offer.liveInDays} days, {usd(pricing.standard)} one time, and you own it.</p>
      <div class="hero__actions">
        <Button href={shell.cta.href} fullWidthMobile>{shell.cta.label}</Button>
        <Button variant="secondary" href={secondary.href} fullWidthMobile>{secondary.label}</Button>
      </div>
      <a class="hero__call" href={contact.phoneHref}><Phone class="hero__call-icon" aria-hidden="true" /><span>Call or text {business.ownerFirst}: <strong>{contact.phoneDisplay}</strong></span></a>
    </div>

    <div class:list={["hero__visual", `hero__visual--${hero.mode}`]}>
      {hero.mode === "workorder" && (
        <CornerFrame class="hero__ticket-frame">
          <JobTicket class="hero__ticket" number="#001" title="New website for your business" titleAs="h2" stamp stampPlacement="corner"
            items={[
              { label: "Built for phones first" },
              { label: "Tap-to-call on every page" },
              { label: "Your Google reviews up front" },
              { label: "Quote form to your inbox" },
              { label: "Set up for local Google searches" },
              { label: "Live in", value: `${offer.liveInDays} days` },
              { label: "You own it", value: "100%" },
            ]}
            total={{ label: "One-time price", value: usd(pricing.standard) }} />
        </CornerFrame>
      )}

      {hero.mode === "devices" && (
        <div class="hero__devices">
          <JobTicket class="hero__mini-ticket" number="001" title="New website" titleAs="h2" stamp
            items={[{ label: "Phone-first design" }, { label: "Tap-to-call" }, { label: "Live in", value: `${offer.liveInDays} days` }]} />
          <CornerFrame>
            <DevTag class:list={["hero__devgroup", { "is-solo": solo }]} {...linkAttrs}>
              {showLaptop && <DeviceMock kind="laptop" src={laptop} alt={sampleAlt} />}
              {showPhone && <DeviceMock kind="phone" src={phone} alt={showLaptop ? "" : sampleAlt} class={solo ? "hero__phone-solo" : "hero__phone-over"} />}
            </DevTag>
          </CornerFrame>
          <Pill class="hero__pill">Sample site, fictional business</Pill>
        </div>
      )}

      {hero.mode === "photo" && (
        <div class="hero__photo">
          <CornerFrame>
            {photos.founderHero
              ? <OptimizedImage class="hero__photo-img" src={photos.founderHero} alt="George, founder of Landed Local, in Columbus" width={800} height={1000} loading="eager" fetchpriority="high" decoding="async" />
              : <div class="hero__photo-img hero__photo-ph" role="img" aria-label="Founder photo placeholder"></div>}
          </CornerFrame>
          {phone && (
            <div class="hero__photo-phone">
              <DeviceMock kind="phone" src={phone} alt={sampleAlt} />
              <Pill class="hero__pill">Sample site, fictional business</Pill>
            </div>
          )}
        </div>
      )}
    </div>
  </div>
</Section>

<style>
  .hero { padding-top: var(--hero-pad-top); padding-bottom: var(--hero-pad-bottom); }
  .hero__grid { display: grid; gap: var(--hero-gap); align-items: center; }
  @media (min-width: 900px) { .hero__grid { grid-template-columns: 55fr 45fr; } }
  .hero__text { display: grid; gap: var(--hero-stack); justify-items: start; min-width: 0; }
  .hero__h1 { margin: 0; font-size: var(--hero-h1); line-height: var(--leading-h1); letter-spacing: var(--tracking-h1); }
  .hero__h1 :global(.hero__line) { display: block; white-space: nowrap; }
  .hero__lead { margin: 0; font-size: var(--hero-text-lead); line-height: var(--leading-body); max-width: var(--prose-max); color: var(--color-charcoal); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-button-stack); width: 100%; }
  @media (max-width: 639px) { .hero__actions { flex-direction: column; } }
  .hero__call { display: inline-flex; align-items: center; gap: var(--space); color: var(--color-teal); font-size: var(--text-small); text-decoration: none; min-height: var(--button-min-h); }
  .hero__call:hover span { text-decoration: underline; }
  .hero__call:focus-visible { outline: var(--stroke-focus) solid var(--color-teal); outline-offset: var(--focus-offset); }
  .hero__call :global(.hero__call-icon) { width: var(--icon-size); height: var(--icon-size); flex: none; }
  .hero__visual { min-width: 0; }
  .hero__visual--workorder { padding-bottom: calc(var(--space) * 4); }

  .hero__visual :global(.hero__ticket-frame) { transform: rotate(var(--hero-ticket-rotate)); }
  .hero__visual :global(.hero__ticket .ticket__check) { align-self: flex-start; }

  .hero__devices { position: relative; display: grid; gap: calc(var(--space) * 2); justify-items: start; }
  .hero__devices > :global(.corner-frame) { width: 100%; }
  .hero__devgroup { position: relative; display: block; text-decoration: none; padding-bottom: calc(var(--space) * 4); }
  a.hero__devgroup:focus-visible { outline: var(--stroke-focus) solid var(--color-teal); outline-offset: var(--focus-offset); }
  .hero__devgroup:not(.is-solo) { padding-right: calc(var(--space) * 2); }
  .hero__devgroup :global(.hero__phone-over) { position: absolute; right: 0; bottom: 0; width: var(--device-phone-w); }
  .hero__devgroup.is-solo { display: flex; justify-content: center; padding-bottom: 0; }
  .hero__devgroup :global(.hero__phone-solo) { width: var(--device-phone-solo-w); }
  .hero__devices :global(.hero__mini-ticket) { display: none; }
  @media (min-width: 900px) {
    .hero__devices { padding-top: calc(var(--space) * 8); }
    .hero__devices :global(.hero__mini-ticket) {
      display: block; position: absolute; z-index: 2; top: 0; left: calc(var(--space) * -4);
      width: var(--hero-compact-ticket-w); padding: calc(var(--space) * 2); transform: rotate(var(--hero-ticket-rotate));
    }
    .hero__devices :global(.hero__mini-ticket .ticket__head) { padding-bottom: var(--space); }
    .hero__devices :global(.hero__mini-ticket .ticket__title) { margin-block: var(--space); }
    .hero__devices :global(.hero__mini-ticket .ticket__items) { font-size: var(--text-small); gap: calc(var(--space) * 0.5); }
    .hero__devices :global(.hero__mini-ticket .ticket__stamp) { font-size: var(--text-small); padding: calc(var(--space) * 0.5) var(--space); }
  }

  .hero__photo { position: relative; padding-bottom: calc(var(--space) * 6); }
  .hero__photo-img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .hero__photo-ph { background: var(--placeholder-fill); }
  .hero__photo-phone { position: absolute; z-index: 2; left: calc(var(--space) * -1); bottom: 0; width: var(--device-phone-w); display: grid; gap: var(--space); justify-items: start; }
  .hero__photo-phone :global(.hero__pill) { white-space: nowrap; }
</style>
