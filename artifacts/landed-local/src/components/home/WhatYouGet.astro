---
import Card from "../Card.astro";
import CheckList from "../CheckList.astro";
import Eyebrow from "../Eyebrow.astro";
import Section from "../Section.astro";
import Pill from "../Pill.astro";
import { site } from "../../config/site";

const { offer } = site;
const items = [
  `Up to ${offer.maxPages} pages, built around your services and service area`,
  "Built for phones first, with tap-to-call on every page",
  "A quote request form that lands in your inbox",
  "Your best Google reviews on the homepage",
  "Set up to show up in local Google searches",
  "Linked to your Google Business Profile",
  `${offer.callTrackingDays} days of free call tracking: see every call your site brings in, answered or missed`,
  `${offer.revisionRounds} rounds of revisions, live within ${offer.liveInDays} days of getting your info`,
  "You own the site and the domain",
];
const report = [
  { label: "Calls from your website", value: "23" },
  { label: "Answered", value: "15" },
  { label: "Missed", value: "8", missed: true },
  { label: "Missed after hours", value: "5", missed: true },
  { label: "Quote form requests", value: "6" },
];
---

<Section id="what-you-get" bg="offwhite" class="what-you-get">
  <Eyebrow>What you get</Eyebrow>
  <h2 class="what-you-get__heading">A website built to make the phone ring</h2>
  <div class="what-you-get__grid">
    <CheckList items={items} class="what-you-get__list" />
    <Card as="article" class="report">
      <div class="report__head">
        <h3>Your 30-day call report</h3>
        <Pill>Sample report, example numbers</Pill>
      </div>
      <table class="report__table">
        <caption class="report__sr-only">Example call and quote-request totals over 30 days</caption>
        <tbody>
          {report.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td class:list={["price", { "report__missed": row.missed }]}>{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <small class="report__note">You'll get this for your own site after 30 days.</small>
    </Card>
  </div>
</Section>

<style>
  .what-you-get__heading { margin: calc(var(--space) * 2) 0 calc(var(--space) * 4); }
  .what-you-get__grid { display: grid; gap: calc(var(--space) * 5); align-items: start; }
  .what-you-get__list { gap: calc(var(--space) * 2); }
  .report { display: flex; flex-direction: column; gap: calc(var(--space) * 2); }
  .report__head { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space); }
  .report__head h3 { margin: 0; }
  .report__table { width: 100%; border-collapse: collapse; }
  .report__table tr { border-bottom: var(--stroke-hair) solid var(--color-rule); }
  .report__table tr:last-child { border-bottom: 0; }
  .report__table th, .report__table td { padding-block: calc(var(--space) * 1.25); }
  .report__table th { text-align: left; font-weight: var(--weight-medium); }
  .report__table td { text-align: right; font-size: var(--text-h3); }
  .report__missed { color: var(--color-orange-burnt); }
  .report__note { color: var(--color-steel); }
  .report__sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  @media (min-width: 900px) {
    .what-you-get__grid { grid-template-columns: 1fr 0.9fr; }
    .report__head { flex-direction: row; justify-content: space-between; align-items: center; flex-wrap: wrap; }
  }
</style>
