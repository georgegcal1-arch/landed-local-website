---
import Phone from "lucide-astro/Phone";
import Button from "../Button.astro";
import { site } from "../../config/site";
interface Props { hideBooking?: boolean }
const { hideBooking = false } = Astro.props;

const isHome = Astro.url.pathname === "/";
const bookingHref = isHome ? site.booking.homeAnchor : site.booking.bookPath;
---
<header class="hdr">
  <div class="hdr__in container-content">
    <a href="/" class="hdr__logo"><img src={site.brand.headerLogo} alt={`${site.business.name} home`} width="276" height="56" loading="eager" decoding="async" /></a>
    <a href={site.contact.phoneHref} class="hdr__phone"><Phone size={18} aria-hidden="true" />{site.contact.phoneDisplay}</a>
    {!hideBooking && <Button href={bookingHref} class="hdr__booking">{site.booking.headerLabel}</Button>}
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: var(--z-header); background: var(--color-offwhite); border-bottom: var(--stroke-hair) solid var(--color-rule); }
  .hdr__in { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: var(--space) calc(var(--space) * 2); min-height: var(--header-h); padding-block: var(--space); }
  .hdr__logo { display: inline-flex; align-items: center; min-height: var(--icon-btn); border-radius: var(--radius-sharp); }
  .hdr__logo img { height: var(--logo-h); width: auto; display: block; }
  .hdr__phone { display: inline-flex; justify-self: end; align-items: center; gap: var(--space); min-height: var(--icon-btn); color: var(--color-charcoal); font-weight: var(--weight-semibold); font-size: var(--text-small); text-decoration: none; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hdr__phone:hover { color: var(--color-teal); }
  .hdr__phone :global(svg) { color: var(--color-teal); }
  .hdr__in :global(.hdr__booking) { grid-column: 1 / -1; white-space: nowrap; }
  @media (max-width: 767px) {
    .hdr__in :global(.hdr__booking) { display: none; }
  }
  @media (min-width: 640px) {
    .hdr__in { display: flex; gap: calc(var(--space) * 3); }
    .hdr__phone { margin-left: auto; }
    .hdr__in :global(.hdr__booking) { flex: none; }
  }
  @media (min-width: 900px) {
    .hdr__logo img { height: var(--logo-h-desktop); }
  }
</style>
