---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import PencilMark from "../components/PencilMark.astro";
import JobTicket from "../components/JobTicket.astro";
import ToolStrip from "../components/ToolStrip.astro";
import CostBill from "../components/CostBill.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import WorkOrderSteps from "../components/WorkOrderSteps.astro";
import CornerFrame from "../components/CornerFrame.astro";
import RulerDivider from "../components/RulerDivider.astro";
import FAQ from "../components/FAQ.astro";
import PhoneDemo from "../components/PhoneDemo.astro";
import BookSection from "../components/BookSection.astro";
import { site } from "../config/site";

const { booking, business, contact, caseStudies } = site;
const book = booking.homeAnchor;
const founderSrc = site.photos.founder ?? site.brand.profilePhoto;

const costs = [
  { problem: "Missed calls", cost: "Lost customers", sentence: "The phone rings while you're on a job, and the caller tries the next company.", stat: "27%", statLabel: "of calls to home-service companies go unanswered.", source: "Invoca, 2024" },
  { problem: "Slow follow-up", cost: "Fewer jobs", sentence: "A new lead waits hours for a callback. By then they've hired someone else.", stat: "21×", statLabel: "more likely to qualify a new lead you reach within 5 minutes instead of 30.", source: "InsideSales.com & MIT study, 2007" },
  { problem: "Manual admin", cost: "Lost evenings", sentence: "Invoices, estimates, data entry and follow-ups pile up until after dinner.", stat: "? hrs", statLabel: "a week on admin. We'll measure yours on the call." },
  { problem: "Scattered systems", cost: "Lost leads", sentence: "Calls, texts and quotes sit in too many apps, so leads slip through the cracks.", stat: "? leads", statLabel: "slipping through each month. We'll count them on the call." },
];
const services = [
  { number: "01", outcome: "NEVER MISS ANOTHER CALL", name: "AI Receptionist", description: "Answers every call in a natural voice, day or night, even when two come in at once. It knows your services, hours and service area, asks your questions, and books the appointment on your calendar.", bullets: ["Answers nights, weekends and while you're on a job", "Qualifies the caller and books the job", "Hands urgent or tricky calls to your team", "Every call logged with a short summary"] },
  { number: "02", outcome: "TURN MORE LEADS INTO JOBS", name: "Speed-to-Lead & Reactivation", description: "Calls every new form or ad lead within a minute, while they're still deciding who to hire. Then works through the old quotes and past customers already in your system and books the ones ready now.", bullets: ["New leads called within a minute", "Old quotes and past customers called again", "Appointments land right on your calendar", "Built to follow calling and texting consent rules"] },
  { number: "03", outcome: "GET YOUR EVENINGS BACK", name: "Workflow Automation", description: "Takes the repeat office work off your plate: invoices, estimates, follow-up texts, review requests and reports. Connected to the tools you already use.", bullets: ["Invoices and estimates sent automatically", "Follow-ups and review requests on autopilot", "No more copying info between apps", "Documented and monitored, so nothing breaks quietly"] },
  { number: "04", outcome: "EVERY LEAD IN ONE PLACE", name: "CRM Buildout", description: "One system where every call, text, form and job lives, set up around how you actually sell. Already paying for one nobody uses? We fix it.", bullets: ["Pipeline built around your sales steps", "One inbox for calls, texts and email", "A dashboard of leads, booked jobs and revenue", "Your team trained on it"] },
  { number: "05", outcome: "FIX WHAT NO SOFTWARE DOES", name: "Custom AI Tools", description: "Problem not on this list? For the one that's specific to your business, we scope a tool with you, build it, and hand it over working.", bullets: ["Quoting tools that price a job in minutes", "A knowledge assistant your crew asks instead of calling you", "Built on your own pricing and process", "Scoped on a free call before any build"], wide: true },
];
const steps = [
  { number: "001", title: "Find the leaks", text: "Free 30-minute call. We put a dollar number on what's slipping.", stamp: "FOUND" },
  { number: "002", title: "Build the fix", text: "Our developers build it around your tools. You approve it before launch.", stamp: "BUILT" },
  { number: "003", title: "Measure it", text: "A monthly report on calls answered, leads followed up and jobs booked.", stamp: "RESULTS" },
];
const faqs = [
  { q: "What does it cost?", a: "It depends on what we fix and how big your business is. Projects are a one-time setup plus a monthly fee for running and improving it. On the call we work out what the problem is costing you first, so the price makes sense next to that number." },
  { q: "Will callers know it's AI?", a: "It sounds natural, and it's set up to say it's an AI assistant if someone asks. Anything tricky goes straight to your team." },
  { q: "What if my problem isn't on your list?", a: "Tell me on the call. If no tool fixes it, we can build one, and we'll scope it with you before anything is built." },
  { q: "Do I have to buy everything?", a: "No. Most clients start with the one system that fixes their biggest leak, then add more once it pays off." },
];
const callItems = booking.callItems;
const values = ["A person, not a platform", "Done for you, not DIY", "Measured results, not promises"];
---
<BaseLayout title="AI Receptionist, Lead Follow-Up and Automation for Roofing and HVAC Companies">
  <!-- 1. Hero -->
  <Section bg="offwhite" blueprint class:list={["home-hero", { "home-hero--demo": site.heroDemo.show }]}>
    <div class="home-hero__grid">
      <div class="home-hero__copy">
        <Eyebrow>{site.audienceLine}</Eyebrow>
        <h1 class="home-hero__h1"><PencilMark>More Landed Jobs.</PencilMark> No New Hires.</h1>
        <p class="home-hero__lead">We build systems that answer calls, follow up on leads and clear the admin off your plate, so you get your evenings back.</p>
        <div class="home-actions">
          <Button href={book} fullWidthMobile>{booking.buttonLabel}</Button>
          <Button variant="text-link" href="#costs" class="home-hero__costs-link">See where jobs slip away ↓</Button>
        </div>
        <p class="home-small home-hero__reassure"><small>{booking.reassurance}</small></p>
      </div>
      {site.heroDemo.show ? (
        <div class="home-hero__demo"><PhoneDemo /></div>
      ) : (
        <div class="home-hero__ticket home-stamp" data-reveal>
          <JobTicket number="0001" title={`FREE ${booking.callName}`} items={callItems.map((label) => ({ label }))} total={{ label: "30 min", value: "Free" }} stamp stampText="FREE" />
        </div>
      )}
    </div>
    {site.tools.show && <div class="home-hero__tools"><ToolStrip /></div>}
  </Section>

  <!-- 2. Costs -->
  <Section id="costs" bg="paper" class="home-target">
    <Eyebrow>THE PROBLEM</Eyebrow>
    <h2 class="home-h2">What it's costing you</h2>
    <CostBill label="COST OF DOING NOTHING" items={costs} total={{ label: "YOUR TOTAL", value: "?", note: "We'll put a dollar number on it in a free 30-minute call." }} />
    <div class="home-actions home-after">
      <Button href={book} fullWidthMobile>{booking.buttonLabel}</Button>
      <p class="home-small"><small>{booking.reassurance}</small></p>
    </div>
  </Section>

  <!-- 3. Services -->
  <Section bg="charcoal" blueprint>
    <Eyebrow>WHAT WE FIX</Eyebrow>
    <h2 class="home-h2 home-h2--tight">Five ways we fix the leaks</h2>
    <p class="home-sub">We start with the one costing you the most.</p>
    <ServiceGrid services={services} href={book} />
    <div class="home-actions home-after">
      <p class="home-closer">Not sure which one you need? That's what the call is for.</p>
      <Button href={book} fullWidthMobile>{booking.buttonLabel}</Button>
    </div>
  </Section>

  <!-- 4. Proof -->
  {caseStudies.show && (
    <Section id="proof" bg="offwhite">
      <Eyebrow>{caseStudies.eyebrow}</Eyebrow>
      <h2 id="proof-heading" class="home-h2">{caseStudies.heading}</h2>
      <div data-proof>
        <div id="proof-cards" class="home-proof__cards" data-proof-row role="region" aria-labelledby="proof-heading" tabindex="0">
          {caseStudies.cards.map((card) => (
            <div id={`proof-${card.number}`} class="home-proof__card">
              <JobTicket number={card.number} title={card.trade} description={card.system} compactResult plainItems
                items={[{ label: card.label, value: card.value }]} stamp stampText={caseStudies.stamp} />
            </div>
          ))}
        </div>
        <div class="home-proof__dots" data-proof-dots role="group" aria-label="Choose a development-team result" hidden>
          {caseStudies.cards.map((card, i) => (
            <button type="button" data-proof-dot aria-label={`Show result ${i + 1}: ${card.trade}`} aria-controls={`proof-${card.number}`} aria-current={i === 0 ? "true" : "false"}><span aria-hidden="true"></span></button>
          ))}
        </div>
      </div>
      <p class="home-note"><small>{caseStudies.note}</small></p>
    </Section>
  )}

  <!-- 5. How it works -->
  <Section bg="paper">
    <Eyebrow>HOW IT WORKS</Eyebrow>
    <h2 class="home-h2">Three work orders, start to finish</h2>
    <WorkOrderSteps steps={steps} />
  </Section>

  <!-- 6. George + FAQ -->
  <Section bg="offwhite">
    <div class="home-split home-split--about">
      <div class="home-about">
        <div class="home-about__intro">
          <div class="home-about__photo">
            <CornerFrame>
              <img src={founderSrc} alt={site.photos.founder ? `${business.ownerFirst}, founder of ${business.name}` : `${business.name} brand mark`} width="1080" height="1080" loading="lazy" decoding="async" />
            </CornerFrame>
          </div>
          <div>
            <Eyebrow>MEET GEORGE</Eyebrow>
            <h2 class="home-about__heading">The person you'll work with</h2>
          </div>
        </div>
        <p class="home-about__bio">Hi, I'm {business.ownerFirst}. I started {business.name} to help service companies stop losing work they already earned. I'm your one point of contact, from the first call to launch and every month after. A team of specialist developers, who've built these systems for other home-service companies, builds and maintains yours. (I'm studying business at Ohio State while building this here in {business.city}.)</p>
        <div class="home-values">
          {values.map((v) => (
            <div class="home-values__row">
              <div class="home-values__tick"><RulerDivider variant="orange" /></div>
              <p>{v}</p>
            </div>
          ))}
        </div>
        <JobTicket class="home-about__contact" number="0002" title="Your point of contact" plainItems items={[
          { label: `${business.ownerFirst}, founder` },
          { label: `${business.city}, ${business.state}` },
          { label: `Call or text ${contact.phoneDisplay}` },
        ]} />
      </div>
      <div>
        <h2 class="home-h2">Straight answers</h2>
        <FAQ items={faqs} />
      </div>
    </div>
  </Section>

  <!-- 7. Book -->
  <BookSection />
</BaseLayout>

<script>
  import "../scripts/proof-cards";
</script>

<style>
  :global(#costs) { scroll-margin-top: calc(var(--header-h) + var(--space) * 2); }

  .home-h2 { margin: calc(var(--space) * 1.5) 0 calc(var(--space) * 4); }
  .home-h2--tight { margin-bottom: var(--space); }
  .home-sub { margin: 0 0 calc(var(--space) * 4); max-width: var(--prose-max); }
  .home-small { margin: 0; }
  .home-small small { color: var(--color-steel); }
  :global([data-tone="dark"]) .home-small small { color: var(--color-rule); }
  .home-after { margin-top: calc(var(--space) * 4); }
  .home-actions { display: flex; flex-direction: column; align-items: stretch; gap: var(--space-button-stack); }
  @media (min-width: 640px) { .home-actions { flex-direction: row; flex-wrap: wrap; align-items: center; gap: calc(var(--space) * 3); } }
  .home-closer { margin: 0; font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-h3); line-height: var(--leading-tight); }

  /* Hero */
  :global(.home-hero) { padding-top: var(--hero-pad-top); }
  .home-hero__grid { display: grid; gap: var(--hero-gap); align-items: center; }
  .home-hero__copy { display: contents; }
  .home-hero__grid { row-gap: var(--hero-stack); }
  .home-hero__h1 { font-size: var(--hero-h1); margin: 0; }
  .home-hero__lead { font-size: var(--hero-text-lead); margin: 0; }
  .home-hero__costs-link { align-self: center; }
  .home-hero__ticket { grid-row: 5; min-width: 0; }
  .home-hero__demo { min-width: 0; display: flex; justify-content: center; padding-top: calc(var(--space) * 2); }
  .home-hero__tools { margin-top: calc(var(--space) * 8); }
  @media (max-width: 767px) {
    :global(.sec.home-hero.home-hero--demo) { padding-bottom: calc(var(--space) * 4); }
    :global(.home-hero--demo) .home-hero__tools { margin-top: calc(var(--space) * 4); }
  }
  @media (min-width: 768px) {
    :global(.sec.home-hero.home-hero--demo) { padding-top: var(--demo-hero-pad-top); }
  }
  @media (min-width: 900px) {
    .home-hero__grid { grid-template-columns: 1.25fr 1fr; }
    .home-hero__copy { display: grid; gap: var(--hero-stack); min-width: 0; }
    .home-hero__ticket { grid-row: auto; transform: rotate(var(--hero-ticket-rotate)); }
    .home-hero__demo { padding-top: 0; }
  }

  /* Stamps land once (Home-only wrappers) */
  :global(html.motion-ok) .home-stamp:not(.is-in) :global(.ticket__stamp) { opacity: 0; }
  :global(html.motion-ok) .home-stamp.is-in :global(.ticket__stamp) { animation: home-stamp var(--dur-check) var(--ease-out) var(--dur-ruler) both; }
  @keyframes home-stamp {
    from { opacity: 0; transform: translateY(calc(var(--space) * -0.5)) rotate(calc(var(--stamp-rotate) * 2)) scale(1.4); }
    to { opacity: 1; transform: translateY(calc(var(--space) * -0.5)) rotate(var(--stamp-rotate)) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-stamp :global(.ticket__stamp) { opacity: 1; animation: none; transition: none; }
    .home-hero__ticket { transition: none; }
  }

  /* Splits */
  .home-split { display: grid; gap: calc(var(--space) * 6); align-items: start; }
  @media (min-width: 900px) {
    .home-split--about { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: calc(var(--space) * 6); }
  }

  /* Proof */
  .home-proof__cards { display: flex; gap: calc(var(--space) * 2); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; margin-right: calc(var(--gutter) * -1); padding-block: var(--space); padding-right: var(--gutter); }
  .home-proof__card { display: flex; flex: 0 0 85vw; min-width: 0; scroll-snap-align: start; }
  .home-proof__card :global(.ticket) { width: 100%; }
  .home-proof__dots:not([hidden]) { display: flex; justify-content: center; }
  .home-proof__dots button { display: grid; place-items: center; width: var(--button-min-h); height: var(--button-min-h); padding: 0; border: 0; background: transparent; cursor: pointer; }
  .home-proof__dots button span { width: var(--space); height: var(--space); border: var(--stroke-outline) solid var(--color-steel); border-radius: 50%; }
  .home-proof__dots button[aria-current="true"] span { background: var(--color-teal); border-color: var(--color-teal); }
  .home-proof__dots button:focus-visible, .home-proof__cards:focus-visible { outline: var(--stroke-focus) solid var(--color-teal); outline-offset: var(--focus-offset); }
  @media (min-width: 1100px) {
    .home-proof__cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-right: 0; padding-right: 0; overflow: visible; }
    .home-proof__dots:not([hidden]) { display: none; }
  }
  .home-note { margin: calc(var(--space) * 5) 0 0; }
  .home-note small { color: var(--color-steel); }

  /* About */
  .home-about { display: grid; gap: calc(var(--space) * 2); }
  .home-about__intro { display: grid; grid-template-columns: calc(var(--space) * 15) minmax(0, 1fr); gap: calc(var(--space) * 2); align-items: center; }
  .home-about__heading { margin: calc(var(--space) * 1.5) 0 0; }
  .home-about__photo img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-sharp) var(--radius-sharp) var(--radius-sharp) var(--radius-corner); }
  .home-about__bio { margin: 0; }
  @media (min-width: 900px) {
    .home-about { gap: calc(var(--space) * 1.5); }
    .home-about__bio { font-size: var(--text-small); line-height: calc(var(--space) * 3); }
    .home-about :global(.home-about__contact.ticket) { padding: calc(var(--space) * 1.5); }
    .home-about :global(.home-about__contact .ticket__head) { padding-bottom: var(--space); }
    .home-about :global(.home-about__contact .ticket__title) { margin-block: var(--space); font-size: var(--text-h3); }
    .home-about :global(.home-about__contact .ticket__items) { gap: calc(var(--space) * 0.5); font-size: var(--text-small); line-height: var(--leading-tight); }
  }
  .home-values { display: grid; gap: var(--space); }
  .home-values__row { display: flex; align-items: baseline; gap: var(--space); }
  .home-values p { min-width: 0; margin: 0; font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-small); line-height: var(--leading-tight); }
  .home-values__tick { flex: 0 0 var(--ruler-tick); align-self: center; }

</style>
