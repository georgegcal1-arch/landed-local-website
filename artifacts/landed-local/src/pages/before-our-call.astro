---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Card from "../components/Card.astro";
import CornerFrame from "../components/CornerFrame.astro";
import CheckList from "../components/CheckList.astro";
import JobTicket from "../components/JobTicket.astro";
import RulerDivider from "../components/RulerDivider.astro";
import WorkOrderSteps from "../components/WorkOrderSteps.astro";
import FAQ from "../components/FAQ.astro";
import { site } from "../config/site";

const loomEmbedUrl = site.preCall.loomEmbedUrl;

const prep = [
  { title: "Confirm the invite.", text: "Accept the calendar invite so it's on your calendar, and mark the email as 'I know this sender' so reminders don't go to spam." },
  loomEmbedUrl
    ? { title: "Watch the video.", text: "Who we are, what we build and what the call covers." }
    : { title: "Read this page.", text: "What we'll cover, what to have handy, and whether it's a fit." },
  { title: "Join from a computer if you can.", text: "I'll share my screen, including a live demo. The Google Meet link is in your invite." },
];
const cover = [
  "Where your leads come from and what happens when the phone rings",
  "How you follow up on new leads and open estimates",
  "Where jobs slip through and where your time goes",
  "Whether AI can fix it, and what that would look like",
  "About how many calls you get a week",
  "Your average job value",
];
const ready = [
  "About how many calls you get a week",
  "Your average job value",
  "How new leads come in today",
  "What happens to calls after hours",
  "The two or three things that frustrate you most right now",
  "30 minutes without interruptions",
];
const goodFit = [
  "You're already doing real revenue and getting steady leads",
  "Calls, follow-up or admin are costing you jobs or hours",
  "You'd invest in fixing a problem worth five or six figures a year",
];
const notFit = [
  "You're just getting started and need leads first",
  "You want the cheapest tool available",
  "You're only curious about AI in general",
];
const after = [
  { number: "01", title: "Proposal", text: "What we'd build, how it fits your business, the timeline and the investment.", stamp: "QUOTED" },
  { number: "02", title: "Build", text: "Usually a few weeks. We handle setup, testing and training.", stamp: "BUILT" },
  { number: "03", title: "Launch and support", text: "I stay your point of contact and send you a monthly report on results.", stamp: "LIVE" },
];
const faqs = [
  { q: "Is this a sales call?", a: "No. It's a diagnosis. If AI isn't the right fix yet, I'll tell you." },
  { q: "Do I need to be technical?", a: "No. If you can text and email, you can use what we build." },
  { q: "What does it cost?", a: "It depends on what you need, since everything is custom. If it's a fit, you'll see the exact investment before you decide anything." },
  { q: "Need to reschedule?", a: "Use the link in your calendar invite, or call or text 614-321-8001." },
];
const pad = (n: number) => String(n + 1).padStart(2, "0");
---
<BaseLayout
  title="Before Our Call"
  description={loomEmbedUrl
    ? "You're booked for your Missed-Jobs Review. Watch the short video, see what we'll cover and what to bring, so our 30 minutes are useful."
    : "You're booked for your Missed-Jobs Review. See what we'll cover, what to have handy and whether it's a fit."}
  robots="noindex, nofollow"
  hideBookingActions
>
  <Section bg="paper" blueprint>
    <Eyebrow>Before our call</Eyebrow>
    <h1 class="pc-h1">{loomEmbedUrl ? "You're booked. Watch this before our call." : "You're booked. Here's what to expect."}</h1>
    <p class="pc-lede">{loomEmbedUrl ? "It's about 6 minutes, and it makes our time together far more useful." : "A few minutes here makes our 30 minutes far more useful."}</p>
    <ol class="pc-cards">
      {prep.map((p, i) => (
        <Card as="li" class="pc-card">
          <span class="pc-num" aria-hidden="true">{pad(i)}</span>
          <h2 class="pc-card-h">{p.title}</h2>
          <p>{p.text}</p>
        </Card>
      ))}
    </ol>
  </Section>
  <RulerDivider variant="orange" />

  {loomEmbedUrl && (
    <>
      <Section bg="offwhite">
        <CornerFrame class="pc-frame">
          <div class="pc-video">
            <iframe src={loomEmbedUrl} title="Before our call video" loading="lazy" allow="fullscreen" allowfullscreen></iframe>
          </div>
        </CornerFrame>
      </Section>
      <RulerDivider />
    </>
  )}

  <Section bg="offwhite">
    <div class="pc-work-orders">
      <JobTicket number="0001" title="Your Missed-Jobs Review" items={cover.map((label) => ({ label }))} />
      <JobTicket number="0002" title="Bring to the call" plainItems items={ready.map((label) => ({ label }))} />
    </div>
  </Section>

  <Section bg="paper">
    <h2 class="pc-h2">Is this a fit?</h2>
    <div class="pc-split">
      <div>
        <h3 class="pc-h3">A good fit</h3>
        <CheckList items={goodFit} />
      </div>
      <div>
        <h3 class="pc-h3">Probably not a fit</h3>
        <ul class="pc-dashes">
          {notFit.map((t) => <li><span class="pc-dash" aria-hidden="true"></span><span>{t}</span></li>)}
        </ul>
      </div>
    </div>
  </Section>
  <RulerDivider />

  <Section bg="offwhite">
    <h2 class="pc-h2">What happens after the call</h2>
    <WorkOrderSteps steps={after} />
  </Section>

  <Section bg="offwhite">
    <h2 class="pc-h2">Questions</h2>
    <FAQ items={faqs} structuredData={false} />
  </Section>
</BaseLayout>

<style>
  .pc-h1 { margin: calc(var(--space) * 2) 0 0; max-width: var(--prose-max); }
  .pc-lede { margin: calc(var(--space) * 2) 0 0; max-width: var(--prose-max); }
  .pc-cards { list-style: none; padding: 0; margin: calc(var(--space) * 5) 0 0; display: grid; gap: calc(var(--space) * 2); }
  @media (min-width: 768px) { .pc-cards { grid-template-columns: repeat(3, 1fr); gap: calc(var(--space) * 3); } }
  .pc-num { font-family: var(--font-display); font-weight: var(--weight-heavy); font-size: var(--text-h3); color: var(--color-orange-burnt); font-variant-numeric: tabular-nums; }
  .pc-card-h { font-size: var(--text-h3); line-height: var(--leading-tight); margin: var(--space) 0; }
  .pc-card p { margin: 0; }
  .pc-frame { max-width: calc(var(--space) * 110); margin-inline: auto; }
  .pc-video { position: relative; aspect-ratio: 16 / 9; width: 100%; overflow: hidden; border-radius: var(--radius-sharp) var(--radius-sharp) var(--radius-sharp) var(--radius-corner); }
  .pc-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .pc-video--empty { display: grid; place-items: center; background: var(--color-paper); border: var(--stroke-hair) solid var(--color-rule); }
  .pc-video--empty p { margin: 0; font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-h3); color: var(--color-steel); }
  .pc-h2 { margin: 0 0 calc(var(--space) * 3); }
  .pc-h3 { margin: 0 0 calc(var(--space) * 2); }
  .pc-work-orders { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(var(--space) * 3); align-items: start; }
  @media (min-width: 768px) { .pc-work-orders { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .pc-split { display: grid; gap: calc(var(--space) * 5); align-items: start; }
  @media (min-width: 768px) { .pc-split { grid-template-columns: 1fr 1fr; } }
  .pc-dashes { list-style: none; margin: 0; padding: 0; display: grid; gap: calc(var(--space) * 1.5); }
  .pc-dashes li { display: grid; grid-template-columns: var(--check-size) 1fr; gap: calc(var(--space) * 1.5); align-items: start; }
  .pc-dash { width: var(--check-size); height: var(--stroke-check); background: var(--color-steel); margin-top: calc(var(--text-body) * var(--leading-body) / 2); }
</style>
