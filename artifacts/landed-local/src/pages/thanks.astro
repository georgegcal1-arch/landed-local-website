---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import { site } from "../config/site";
---
<BaseLayout title="Thanks" description="Your mockup request is in. I'll email your custom preview within one business day." noindex>
  <Section bg="offwhite" class="ty">
    <div class="ty__wrap">
      <svg class="ty__check" viewBox="0 0 96 96" width="96" height="96" aria-hidden="true" focusable="false">
        <circle class="ty__ring" cx="48" cy="48" r="44" pathLength="1" />
        <path class="ty__tick" d="M28 50 L42 64 L69 34" pathLength="1" />
      </svg>
      <h1 class="ty__title" id="ty-title">Got it. Your mockup is on the way.</h1>
      <p class="ty__lead">I'll email your custom preview within one business day from <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>. Keep an eye on your inbox, and your spam folder just in case.</p>
      <p class="ty__sooner">Want it sooner? Call or text <a href={site.contact.phoneHref}>{site.contact.phoneDisplay}</a>.</p>
      <div class="ty__actions">
        <Button variant="secondary" href={site.contact.bookingUrl} target="_blank" rel="noopener noreferrer">Book a 15-minute call</Button>
        <Button variant="text-link" href="/">Back to the homepage</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  try {
    const name = sessionStorage.getItem("mockupFirstName");
    const first = name ? name.trim().slice(0, 40) : "";
    const h1 = document.getElementById("ty-title");
    if (first && h1) h1.textContent = `Got it, ${first}. Your mockup is on the way.`;
  } catch {}
</script>

<style>
  .ty { padding-block: 64px; }
  .ty__wrap { max-width: 40rem; }
  .ty__check { display: block; width: 96px; height: 96px; fill: none; stroke: var(--color-teal); stroke-linecap: round; stroke-linejoin: round; }
  .ty__ring { stroke-width: 4; stroke-dasharray: 1; stroke-dashoffset: 1; animation: ty-draw 600ms var(--ease-out) forwards; }
  .ty__tick { stroke-width: 7; stroke-dasharray: 1; stroke-dashoffset: 1; animation: ty-draw 420ms var(--ease-out) 480ms forwards; }
  @keyframes ty-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .ty__ring, .ty__tick { animation: none; stroke-dashoffset: 0; }
  }
  .ty__title { margin: calc(var(--space) * 4) 0 0; max-width: 20ch; }
  .ty__lead { margin: calc(var(--space) * 3) 0 0; font-size: var(--hero-text-lead); }
  .ty__sooner { margin: calc(var(--space) * 3) 0 0; }
  .ty__actions { margin-top: calc(var(--space) * 4); display: flex; flex-wrap: wrap; align-items: center; gap: calc(var(--space) * 3); }
  @media (min-width: 768px) { .ty { padding-block: 104px; } }
</style>
