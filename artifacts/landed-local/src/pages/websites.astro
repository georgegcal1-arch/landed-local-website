---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import CheckList from "../components/CheckList.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import FinalCtaSection from "../components/sections/FinalCtaSection.astro";
import HowItWorksSection from "../components/sections/HowItWorksSection.astro";
import PricingSection from "../components/sections/PricingSection.astro";
import SamplesSection from "../components/sections/SamplesSection.astro";
import IncludedSection from "../components/websites/IncludedSection.astro";
import WebsitesSectionNav from "../components/websites/WebsitesSectionNav.astro";
import TradesSection from "../components/websites/TradesSection.astro";
import WebsitesHero from "../components/websites/WebsitesHero.astro";
import { site } from "../config/site";
---
<BaseLayout
  title="Websites for Local Service Businesses"
  description={`Fast, phone-first websites for plumbers, electricians and local trades in Columbus. $${site.pricing.standard.toLocaleString("en-US")} one time, live in 7 days, and you own it.`}
>
  <div class="websites-page">
    <WebsitesSectionNav />
  <WebsitesHero />
  <IncludedSection />
  <TradesSection />
    <PricingSection />
    <HowItWorksSection>
      <Card slot="below" as="article" class="websites-needs">
        <h3 class="websites-needs__title">What I need from you</h3>
        <CheckList items={[
          "Your logo, if you have one",
          "5 to 10 photos of your work, trucks or team",
          "Your list of services and the areas you serve",
          "Your hours and the best phone number",
          "3 favorite customer reviews, or I'll pull them from Google",
        ]} />
        <small class="text-secondary">I write the words and handle the setup. Your site goes live within 7 days of getting these.</small>
      </Card>
    </HowItWorksSection>
    <SamplesSection />
    <FaqSection mode="all" />
    <FinalCtaSection />
  </div>
</BaseLayout>

<style>
  .websites-page { --websites-nav-height: 48px; }
  .websites-page :global(#included, #pricing, #how-it-works, #faq) {
    scroll-margin-top: calc(var(--header-h) + var(--websites-nav-height) + var(--space) * 2);
  }
  .websites-needs { max-width: 820px; margin: calc(var(--space) * 5) auto 0; }
  .websites-needs__title { margin: 0 0 calc(var(--space) * 2); }
  .websites-needs small { display: block; margin-top: calc(var(--space) * 2); }
  @media (max-width: 899px) {
    .websites-page { --websites-nav-height: 0px; }
    .websites-page :global(#included, #pricing, #how-it-works, #faq) {
      scroll-margin-top: calc(var(--header-h) + var(--space) * 2);
    }
  }
</style>
