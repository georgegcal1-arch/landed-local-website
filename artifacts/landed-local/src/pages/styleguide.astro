---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import RulerDivider from "../components/RulerDivider.astro";
import CornerFrame from "../components/CornerFrame.astro";
import CheckList from "../components/CheckList.astro";
import Card from "../components/Card.astro";
import PencilMark from "../components/PencilMark.astro";
import Section from "../components/Section.astro";
import JobTicket from "../components/JobTicket.astro";
import Pill from "../components/Pill.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import ToolStrip from "../components/ToolStrip.astro";
import CostBill from "../components/CostBill.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import WorkOrderSteps from "../components/WorkOrderSteps.astro";
import FAQ from "../components/FAQ.astro";
import BookingEmbed from "../components/BookingEmbed.astro";
import PhoneDemo from "../components/PhoneDemo.astro";
import BookSection from "../components/BookSection.astro";
import type { SectionBg } from "../components/Section.astro";
import Hero from "../components/Hero.astro";
import CTABand from "../components/CTABand.astro";
import { site } from "../config/site";
import tokens from "../styles/tokens.css?raw";

// Read straight from tokens.css so swatches and labels never drift from the source.
const colors = [...tokens.matchAll(/--color-([a-z-]+):\s*([^;]+);/g)].map((m) => [m[1], m[2].trim()] as const);
const grounds: { bg: SectionBg; label: string }[] = [
  { bg: "offwhite", label: "Offwhite" },
  { bg: "paper", label: "Paper" },
  { bg: "charcoal", label: "Charcoal" },
];
const services = [
  { number: "01", outcome: "NEVER MISS ANOTHER CALL", name: "AI Receptionist", description: "Answers every call in a natural voice, day or night, even when two come in at once. It knows your services, hours and service area, asks your questions, and books the appointment on your calendar.", bullets: ["Answers nights, weekends and while you're on a job", "Qualifies the caller and books the job", "Hands urgent or tricky calls to your team", "Every call logged with a short summary"], wide: false },
  { number: "05", outcome: "FIX WHAT NO SOFTWARE DOES", name: "Custom AI Tools", description: "Problem not on this list? For the one that's specific to your business, we scope a tool with you, build it, and hand it over working.", bullets: ["Quoting tools that price a job in minutes", "A knowledge assistant your crew asks instead of calling you", "Built on your own pricing and process", "Scoped on a free call before any build"], wide: true },
];
const steps = [
  { number: "001", title: "Find the leaks", text: "Free 30-minute call. We put a dollar number on what's slipping.", stamp: "FOUND" },
  { number: "002", title: "Build the fix", text: "Our partner developers build it around your tools. You approve it before launch.", stamp: "BUILT" },
  { number: "003", title: "Measure it", text: "A monthly report on calls answered, leads followed up and jobs booked.", stamp: "RESULTS" },
];
const faqs = [
  { q: "What does it cost?", a: "It depends on what we fix and how big your business is. Projects are a one-time setup plus a monthly fee for running and improving it. On the call we work out what the problem is costing you first, so the price makes sense next to that number." },
  { q: "Will callers know it's AI?", a: "It sounds natural, and it's set up to say it's an AI assistant if someone asks. Anything tricky goes straight to your team." },
];
const items = ["How calls and leads move today", "What slips through, in dollars", "The one fix to start with"];
const proofCard = site.caseStudies.cards[0];
---
<BaseLayout title="Styleguide" description="Landed Local's internal reference for website typography, colors, components, and responsive design." noindex>
  <Section bg="paper" blueprint>
    <Eyebrow>Internal review, not linked</Eyebrow>
    <h1 class="sg-title"><PencilMark>More Landed Jobs.</PencilMark> No New Hires.</h1>
    <p class="sg-lede">Every shared component and variant, measured once. Scroll slowly: rulers, checks and pencil marks draw in once each.</p>
    <nav class="sg-toc" aria-label="Styleguide sections">
      {["colors", "type", "buttons", "labels", "rulers", "checks", "cards", "frames", "tickets", "sections", "pencil-lg", "hero-centered", "hero-split", "tool-strip", "tool-band", "cost-bill", "service-grid", "work-order-steps", "agency-faq", "booking-embed", "booking-inline", "cta-band", "phone-demo", "book-section"].map((s) => <a href={`#${s}`}>{s}</a>)}
    </nav>
  </Section>
  <RulerDivider variant="orange" />

  <Section id="colors">
    <Eyebrow>01 Color tokens</Eyebrow>
    <h2 class="sg-h">Palette</h2>
    <ul class="sg-swatches">
      {colors.map(([name, hex]) => (
        <li class="sg-swatch">
          <span class="sg-swatch__chip" style={`background: var(--color-${name})`}></span>
          <span class="sg-token">--color-{name}</span>
          <span class="sg-meta">{hex}</span>
        </li>
      ))}
    </ul>
  </Section>
  <RulerDivider />

  <div id="type">
    {grounds.map(({ bg, label }) => (
      <Section bg={bg}>
        <Eyebrow>02 Type scale on {label}</Eyebrow>
        <div class="sg-type">
          <div><span class="sg-meta">h1 Manrope 800 var(--text-h1)</span><p class="sg-h1-sample">More Landed Jobs. No New Hires.</p></div>
          <div><span class="sg-meta">h2 Manrope 800 var(--text-h2)</span><h2>Five ways we fix the leaks</h2></div>
          <div><span class="sg-meta">h3 Manrope 700 var(--text-h3)</span><h3>Never miss another call</h3></div>
          <div><span class="sg-meta">body Inter 400 var(--text-body)</span><p>We find where your business is losing jobs and time, and build the AI system that fixes it.</p></div>
          <div><span class="sg-meta">small Inter 500 var(--text-small)</span><p><small>Based in Columbus, Ohio. Working with roofing and HVAC companies.</small></p></div>
          <div>
            <span class="sg-meta">stat Manrope 800 tabular</span>
            <p class="stat sg-stat">51%</p>
            <div class="sg-stat-ruler"><RulerDivider variant="orange" /></div>
          </div>
        </div>
      </Section>
    ))}
  </div>
  <RulerDivider variant="orange" />

  <div id="buttons">
    {grounds.map(({ bg, label }) => (
      <Section bg={bg}>
        <Eyebrow>03 Buttons on {label}</Eyebrow>
        <div class="sg-row sg-mobile-actions">
          <Button href="#buttons" fullWidthMobile>Full-width primary</Button>
          <Button variant="secondary" href="#buttons" fullWidthMobile>Full-width secondary</Button>
          <Button variant="text-link" href="#buttons" fullWidthMobile>Full-width text link</Button>
        </div>
        <div class="sg-row">
          <Button href="#buttons">Primary link</Button>
          <Button>Primary button</Button>
          <Button variant="secondary" href="#buttons">Secondary link</Button>
          <Button variant="secondary">Secondary button</Button>
          <Button variant="text-link" href="#buttons">Text link</Button>
          <Button variant="text-link">Text button</Button>
          <Button disabled>Disabled</Button>
        </div>
        <p class="sg-meta">Tab through to see the 3px teal focus ring. Primary buttons keep charcoal text on orange, including on hover.</p>
      </Section>
    ))}
  </div>

  <Section id="labels" bg="offwhite">
    <Eyebrow>04 Eyebrow and Pill</Eyebrow>
    <h2 class="sg-h">Labels</h2>
    <div class="sg-row">
      <Pill>Roofing</Pill><Pill>HVAC</Pill><Pill>Free · 30 min</Pill>
    </div>
  </Section>
  <RulerDivider />

  <Section id="rulers" bg="offwhite">
    <Eyebrow>05 RulerDivider</Eyebrow>
    <h2 class="sg-h">Default and orange</h2>
    <p class="sg-meta">variant="rule"</p>
  </Section>
  <RulerDivider />
  <Section bg="offwhite"><p class="sg-meta">variant="orange"</p></Section>
  <RulerDivider variant="orange" />
  <Section bg="charcoal"><p class="sg-meta">On charcoal, both variants</p></Section>
  <div data-tone="dark" class="sg-dark-strip"><RulerDivider /><RulerDivider variant="orange" /></div>

  <div id="checks">
    {grounds.map(({ bg, label }) => (
      <Section bg={bg}>
        <Eyebrow>06 CheckList on {label}</Eyebrow>
        <div class="sg-split">
          <CheckList items={items} onDark={bg === "charcoal"} />
          <CheckList items={["Rich item via render slot", "Same drawn check, no extra markup"]} onDark={bg === "charcoal"}>
            {(item: string) => <strong>{item}</strong>}
          </CheckList>
        </div>
      </Section>
    ))}
  </div>

  <Section id="cards" bg="paper">
    <Eyebrow>07 Card and PencilMark</Eyebrow>
    <div class="sg-split">
      <Card>
        <Eyebrow>THE PROBLEM</Eyebrow>
        <h3 class="sg-card-h">Missed calls</h3>
        <p>The phone rings while you're on a job, and the caller tries the next company.</p>
        <Button variant="text-link" href="#cards">Text link in a card</Button>
      </Card>
      <Card as="article">
        <h2>More Landed Jobs. <PencilMark>No New Hires.</PencilMark></h2>
      </Card>
    </div>
  </Section>

  <Section id="frames" bg="offwhite">
    <Eyebrow>08 CornerFrame</Eyebrow>
    <div class="sg-split">
      <CornerFrame class="sg-frame-img">
        <PhotoPlaceholder alt="Landed Local carpenter-square mark on a dark tile" />
      </CornerFrame>
      <CornerFrame>
        <Card><h3>Any content</h3><p>The square meets the content edge and extends 8px; its arms scale to 25% of the content width.</p></Card>
      </CornerFrame>
    </div>
  </Section>
  <Section id="dark-placeholder" bg="charcoal">
    <Eyebrow>Dark-background photo placeholder</Eyebrow>
    <div class="sg-frame-img">
      <CornerFrame hideBracket>
        <PhotoPlaceholder alt="Landed Local carpenter-square mark on an orange tile" />
      </CornerFrame>
    </div>
  </Section>

  <div id="tickets">
    {grounds.map(({ bg, label }) => (
      <Section id={`tickets-${bg}`} bg={bg} blueprint>
        <Eyebrow>09 JobTicket on {label}</Eyebrow>
        <div class="sg-split">
          <JobTicket number="0001" title={site.booking.callName}
            items={items.map((label) => ({ label }))}
            total={{ label: "30 min", value: "$0" }} stamp stampText="FREE" />
          <JobTicket number="001" title="Find the leaks" plainItems
            items={[{ label: "Free 30-minute call. We put a dollar number on what's slipping." }]}
            stamp stampText="FOUND" />
          <JobTicket number={proofCard.number} title={proofCard.trade} description={proofCard.system} compactResult plainItems
            items={[{ label: proofCard.label, value: proofCard.value }]} stamp stampText={site.caseStudies.stamp} />
          <JobTicket number="0002" title="Your point of contact" plainItems
            items={[
              { label: `${site.business.ownerFirst}, founder` },
              { label: `${site.business.city}, ${site.business.state}` },
              { label: `Call or text ${site.contact.phoneDisplay}` },
            ]} />
        </div>
      </Section>
    ))}
  </div>

  <Section bg="charcoal" blueprint>
    <Eyebrow>Light components inside a charcoal Section</Eyebrow>
    <h2 class="sg-h">Foreground stays charcoal on white and paper</h2>
      <Card>
        <Eyebrow>THE PROBLEM</Eyebrow>
        <h3 class="sg-card-h">Missed calls</h3>
        <p>The phone rings while you're on a job, and the caller tries the next company.</p>
        <CheckList items={items} />
        <div class="sg-row"><Button variant="secondary">Secondary</Button><Button variant="text-link" href="#tickets">Text link</Button></div>
      </Card>
  </Section>

  <div id="sections">
    {(["offwhite", "paper", "charcoal", "orange-tint"] as SectionBg[]).map((bg) => [false, true].map((bp) => (
      <Section bg={bg} blueprint={bp}>
        <Eyebrow>10 Section bg="{bg}" blueprint={String(bp)}</Eyebrow>
        <p>Body copy on this ground with an <a href="#sections" class="accent">accent link</a>.</p>
      </Section>
    )))}
  </div>

  <Section id="pencil-lg" bg="offwhite" blueprint>
    <Eyebrow>11a PencilMark size="lg"</Eyebrow>
    <h2 class="sg-h">Large mark for the big headline</h2>
    <p class="sg-pencil-lg"><PencilMark size="lg">No New Hires.</PencilMark></p>
    <p class="sg-meta">Same draw-in, heavier stroke. With reduced motion the line is simply there.</p>
  </Section>

  <div id="hero-centered">
    <Section bg="paper"><Eyebrow>11b Hero layout="centered" tall</Eyebrow><p class="sg-meta">Type-only, used on Home. About 75% of the viewport on laptop and desktop.</p></Section>
    <Hero layout="centered" tall eyebrow={site.audienceLine} ctaHref={site.booking.bookPath} ctaLabel={site.booking.buttonLabel}
      secondaryHref="#cost-bill" secondaryLabel="See where jobs slip away ↓" reassurance={site.booking.reassurance}>
      <span class="hero__line">More Landed Jobs.</span>
      <span class="hero__line hero__accent"><PencilMark size="lg">No New Hires.</PencilMark></span>
      <Fragment slot="lead">We build systems that answer calls, follow up on leads and clear the admin off your plate, so you get your evenings back.</Fragment>
    </Hero>
  </div>

  <div id="hero-split">
    <Section bg="paper"><Eyebrow>11c Hero layout="split"</Eyebrow><p class="sg-meta">The original layout with a side panel. Not used on live pages.</p></Section>
    <Hero layout="split" eyebrow={site.audienceLine} ctaHref={site.booking.bookPath} ctaLabel={site.booking.buttonLabel}
      secondaryHref="#cost-bill" secondaryLabel="See where jobs slip away ↓" reassurance={site.booking.reassurance}>
      <PencilMark>More Landed Jobs.</PencilMark> No New Hires.
      <Fragment slot="lead">We build systems that answer calls, follow up on leads and clear the admin off your plate, so you get your evenings back.</Fragment>
      <div slot="aside"><PhoneDemo /></div>
    </Hero>
  </div>

  <Section id="tool-strip" bg="offwhite">
    <Eyebrow>11 ToolStrip</Eyebrow>
    <h2 class="sg-h">Tools strip</h2>
    <ToolStrip />
  </Section>
  <Section id="tool-band" bg="charcoal" class="sg-tool-band">
    <p class="sg-meta sg-meta--center">11d ToolStrip variant="band" on charcoal: static, centered, wraps on mobile</p>
    <ToolStrip variant="band" headingAs="h3" />
  </Section>
  <RulerDivider />

  <Section id="cost-bill" bg="offwhite">
    <Eyebrow>12 CostBill</Eyebrow>
    <h2 class="sg-h">Cost bill</h2>
    <CostBill
      items={[
        { problem: "Missed calls", cost: "Lost customers", sentence: "The phone rings while you're on a job, and the caller tries the next company.", stat: "27%", statLabel: "of calls to home-service companies go unanswered.", source: "Invoca, 2024" },
        { problem: "Slow follow-up", cost: "Fewer jobs", sentence: "A new lead waits hours for a callback. By then they've hired someone else.", stat: "21×", statLabel: "more likely to qualify a new lead you reach within 5 minutes instead of 30.", source: "InsideSales.com & MIT study, 2007" },
        { problem: "Manual admin", cost: "Lost evenings", sentence: "Invoices, estimates, data entry and follow-ups pile up until after dinner.", stat: "? hrs", statLabel: "a week on admin. We'll measure yours on the call." },
        { problem: "Scattered systems", cost: "Lost leads", sentence: "Calls, texts and quotes sit in too many apps, so leads slip through the cracks.", stat: "? leads", statLabel: "slipping through each month. We'll count them on the call." },
      ]}
      total={{ label: "YOUR TOTAL", value: "?", note: "We'll put a dollar number on it in a free 30-minute call." }} />
  </Section>

  <Section id="service-grid" bg="charcoal" blueprint>
    <Eyebrow>13 ServiceGrid</Eyebrow>
    <h2 class="sg-h">Service cards and rows</h2>
    <ServiceGrid services={services} href={site.booking.bookPath} />
  </Section>

  <Section id="work-order-steps" bg="offwhite" blueprint>
    <Eyebrow>14 WorkOrderSteps</Eyebrow>
    <h2 class="sg-h">Three steps, three tickets</h2>
    <WorkOrderSteps steps={steps} />
  </Section>
  <RulerDivider />

  <Section id="agency-faq" bg="offwhite">
    <Eyebrow>15 FAQ</Eyebrow>
    <h2 class="sg-h">Questions</h2>
    <FAQ items={faqs} />
  </Section>

  <Section id="booking-embed" bg="paper">
    <Eyebrow>16 BookingEmbed</Eyebrow>
    <h2 class="sg-h">Booking calendar</h2>
    <BookingEmbed />
  </Section>

  <Section id="booking-inline" bg="offwhite">
    <Eyebrow>16b BookingEmbed variant="inline"</Eyebrow>
    <h2 class="sg-h">Inline calendar, full content width</h2>
    <BookingEmbed variant="inline" />
  </Section>

  <div id="cta-band">
    <Section bg="paper"><Eyebrow>16c CTABand</Eyebrow><p class="sg-meta">Section bg="charcoal" with the blueprint grid. Ends Home, above the footer's orange ruler.</p></Section>
    <CTABand headingAs="h3" />
  </div>

  <Section id="phone-demo" bg="offwhite" blueprint>
    <Eyebrow>17 PhoneDemo</Eyebrow>
    <h2 class="sg-h">Example conversation</h2>
    <p class="sg-meta">Not used on live pages. Kept so it can come back later.</p>
    <PhoneDemo />
  </Section>
  <BookSection id="book-section" headingAs="h2" />
</BaseLayout>

<style>
  .sg-title { margin-top: calc(var(--space) * 2); }
  .sg-lede { margin-top: calc(var(--space) * 2); }
  .sg-h { margin: calc(var(--space) * 1.5) 0 calc(var(--space) * 4); }
  .sg-meta { display: block; font-family: var(--font-body); font-weight: var(--weight-medium); font-size: var(--text-eyebrow); letter-spacing: 0; color: var(--color-steel); }
  .sg-h1-sample { font-family: var(--font-display); font-weight: 800; font-size: var(--text-h1); line-height: var(--leading-h1); letter-spacing: var(--tracking-h1); color: var(--color-charcoal); }
  :global([data-tone="dark"]) .sg-h1-sample { color: var(--color-offwhite); }
  .sg-token { font-family: var(--font-body); font-weight: var(--weight-semibold); overflow-wrap: anywhere; }
  :global([data-tone="dark"]) .sg-meta { color: var(--color-rule); }
  .sg-toc { display: flex; flex-wrap: wrap; gap: var(--space) calc(var(--space) * 2); margin-top: calc(var(--space) * 3); font-weight: var(--weight-semibold); font-size: var(--text-small); text-transform: capitalize; }
  .sg-toc a { color: var(--color-teal); }
  .sg-swatches { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(calc(var(--space) * 20), 1fr)); gap: calc(var(--space) * 3); }
  .sg-swatch { display: grid; gap: calc(var(--space) * 0.5); font-size: var(--text-small); }
  .sg-swatch__chip { height: var(--swatch-h); border: var(--stroke-hair) solid var(--color-rule); border-radius: var(--radius-sharp) var(--radius-sharp) var(--radius-sharp) var(--radius-corner); margin-bottom: var(--space); }
  .sg-type { display: grid; gap: calc(var(--space) * 3); margin-top: calc(var(--space) * 3); }
  .sg-type > div { border-top: var(--stroke-hair) solid var(--color-rule); padding-top: var(--space); }
  :global([data-tone="dark"]) .sg-type > div { border-color: var(--color-steel); }
  .sg-stat { font-size: var(--text-h2); margin: 0; }
  .sg-stat-ruler { max-width: calc(var(--space) * 16); margin-top: var(--space); }
  .sg-row { display: flex; flex-wrap: wrap; align-items: center; gap: calc(var(--space) * 2); margin: calc(var(--space) * 3) 0; }
  .sg-split { display: grid; gap: calc(var(--space) * 5); margin-top: calc(var(--space) * 3); align-items: start; }
  @media (min-width: 768px) { .sg-split { grid-template-columns: 1fr 1fr; } }
  .sg-card-h { margin: calc(var(--space) * 2) 0 var(--space); }
  .sg-frame-img { max-width: calc(var(--space) * 40); }
  .sg-mobile-actions { display: grid; grid-template-columns: 1fr; gap: var(--space-button-stack); }
  @media (min-width: 640px) {
    .sg-mobile-actions { display: flex; flex-wrap: wrap; align-items: center; gap: calc(var(--space) * 2); }
  }
  .sg-pencil-lg { margin: 0 0 calc(var(--space) * 2); font-family: var(--font-display); font-weight: var(--weight-heavy); font-size: clamp(40px, 7vw, 88px); line-height: 1; color: var(--color-orange-burnt); }
  .sg-meta--center { text-align: center; margin-bottom: calc(var(--space) * 4); }
  .sg-dark-strip { background: var(--color-charcoal); display: grid; gap: calc(var(--space) * 3); padding-bottom: calc(var(--space) * 4); }
</style>
